---
import Base from './Base.astro';
import { site } from '../data/site.js';
const { t, lang } = Astro.props;
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}` : '';
---
<Base title={t.title} description={t.description} lang={lang}>
  <main class="wrap">
    <nav class="lang"><a href="/" aria-current={lang === 'it'}>IT</a> · <a href="/en/" aria-current={lang === 'en'}>EN</a></nav>
    <p class="logo"><img src="/favicon.svg" alt="" width="40" height="40" /> {site.name}</p>
    <h1>{t.h1}</h1>
    <p class="lead">{t.lead}</p>
    <p class="price"><strong>€{site.certificatePrice}</strong> · {t.validity}</p>
    <div class="actions">
      {site.bookingUrl && <a class="btn primary" href={site.bookingUrl}>{t.book}</a>}
      {wa && <a class="btn" href={wa}>WhatsApp</a>}
      {site.phone && <a class="btn" href={`tel:${site.phone}`}>{t.call}</a>}
    </div>
    <p class="soon">{t.soon}</p>
    <address>
      <strong>{lang === 'it' ? site.venue : site.venueEn}</strong><br />
      {site.address}<br />
      <a href={site.mapsUrl}>{t.map}</a>
    </address>
    <footer>{site.name} · P.IVA {site.vat} · PEC {site.pec}</footer>
  </main>
</Base>

<style>
  .wrap { max-width: 640px; margin: 0 auto; padding: 32px 16px 48px; }
  .lang { text-align: right; font-size: 14px; }
  .lang a[aria-current='true'] { font-weight: 700; text-decoration: none; }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--brand-dark); margin-top: 24px; }
  h1 { font-size: clamp(28px, 6vw, 40px); line-height: 1.15; color: var(--brand-dark); margin: 24px 0 12px; }
  .lead { font-size: 18px; color: var(--muted); }
  .price { font-size: 20px; }
  .price strong { background: var(--accent); padding: 2px 8px; border-radius: 6px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 20px 0; }
  .btn { padding: 12px 20px; border-radius: 999px; border: 2px solid var(--brand); text-decoration: none; font-weight: 600; }
  .btn.primary { background: var(--brand); color: #fff; }
  .soon { padding: 12px 16px; background: #fff; border-left: 4px solid var(--accent); border-radius: 6px; }
  address { font-style: normal; margin-top: 24px; }
  footer { margin-top: 40px; font-size: 13px; color: var(--muted); }
</style>
