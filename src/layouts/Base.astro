---
import '@fontsource-variable/inter';
import { site } from '../data/site.js';
// schema: optional JSON-LD object or array of objects for this page.
// noindex: force noindex on one page (e.g. 404); site.indexable=false sets it everywhere.
const { title, description, lang = 'it', schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const robots = noindex || !site.indexable ? 'noindex, follow' : null;
const schemas = schema ? [schema].flat() : [];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0f5c63" />
    {site.showEnglish && <link rel="alternate" hreflang="it" href={new URL('/', Astro.site)} />}
    {site.showEnglish && <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />}
    {site.showEnglish && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'it_IT'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Prevenzione e Salute – certificato medico sportivo non agonistico a Milano, €50" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --brand: #0f5c63;
    --brand-dark: #0a3f44;
    --brand-soft: #e3f0f0;
    --accent: #c6f432;
    --accent-dark: #a8d61a;
    --text: #1b2426;
    --muted: #5b6b6e;
    --line: #dde7e7;
    --bg: #f6f9f9;
    --card: #ffffff;
    /* Shape tokens (v2 canvas): radius 12 / 20 / 28, icon tiles 40 / 48 */
    --radius-s: 12px;
    --radius-m: 20px;
    --radius-l: 28px;
    --radius: var(--radius-m);
    --tile-s: 40px;
    --tile-m: 48px;
    --focus: var(--brand);
    --mbar-space: 0px;
    font-family: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--text);
    background: var(--bg);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; scroll-padding-bottom: var(--mbar-space); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  /* Mobile: room for the sticky Prenota / WhatsApp / Chiama bar */
  @media (max-width: 820px) { :root { --mbar-space: 80px; } }
  /* Visible keyboard focus on every link, button and summary */
  :where(a, button, summary, input, select, textarea, [tabindex]):focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; border-radius: 4px; }
  .skip-link { position: absolute; left: 12px; top: -100px; z-index: 100; background: var(--brand-dark); color: #fff; padding: 12px 18px; border-radius: var(--radius-s); font-weight: 700; text-decoration: none; }
  .skip-link:focus { top: 12px; }
  main:focus { outline: none; }
  body { margin: 0; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  a { color: var(--brand); }
  img { max-width: 100%; display: block; }
  .container { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 11px 22px; border-radius: 999px; font-weight: 650; text-decoration: none; border: 2px solid var(--brand); color: var(--brand); background: transparent; transition: transform .15s, background .15s; }
  .btn:hover { transform: translateY(-1px); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--brand-dark); }
  .btn-primary:hover { background: var(--accent-dark); border-color: var(--accent-dark); }
  .btn-dark { background: var(--brand); color: #fff; }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: 13px; font-weight: 700; color: var(--brand); margin: 0 0 8px; }
  h1, h2, h3 { color: var(--brand-dark); line-height: 1.15; letter-spacing: -0.02em; }
  h2 { font-size: clamp(26px, 4vw, 36px); margin: 0 0 24px; }
  section { padding: 64px 0; }
</style>
