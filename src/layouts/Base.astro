---
const { title, description, lang = 'it' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="it" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --brand: #0f5c63;
    --brand-dark: #0a3f44;
    --accent: #c6f432;
    --text: #1b2426;
    --muted: #5b6b6e;
    --bg: #f6f9f9;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--text);
    background: var(--bg);
  }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.55; }
  a { color: var(--brand); }
</style>
