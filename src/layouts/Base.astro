---
import '@fontsource-variable/inter';
import { site } from '../data/site.js';
// schema: optional JSON-LD object or array of objects for this page.
// noindex: force noindex on one page (e.g. 404); site.indexable=false sets it everywhere.
const { title, description, lang = 'it', schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const robots = noindex || !site.indexable ? 'noindex, follow' : null;
const schemas = schema ? [schema].flat() : [];
const notApi = { not: { href_matches: '/api/*' } };
const speculation = {
  prefetch: [{ where: { and: [{ href_matches: '/*' }, notApi] }, eagerness: 'moderate' }],
  prerender: [{ where: { and: [{ href_matches: '/*' }, notApi, { not: { href_matches: '/prenota/*' } }] }, eagerness: 'moderate' }],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Lets CSS tell "JS is coming" apart from "no JS" (booking form shows a loading state instead of the fallback) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Follow the OS text-size setting (Chrome/Edge; others ignore it). Needs rem type and no root font-size -->
    <meta name="text-scale" content="scale" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#12385a" />
    {site.showEnglish && <link rel="alternate" hreflang="it" href={new URL('/', Astro.site)} />}
    {site.showEnglish && <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />}
    {site.showEnglish && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'it_IT'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Prevenzione e Salute – certificato medico sportivo non agonistico a Milano, €50" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Prefetch same-site pages on hover/pointer-down; prerender all but /prenota/, whose script loads slots on arrival -->
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <slot />
  </body>
</html>


<style is:global>
  /* ==========================================================================
     Design system "Civico caldo" (2026-11-16): precise civic layout; palette "Azzurro clinico" (2026-11-17).
     Every page and component reads these tokens; conventions are summarised in DESIGN.md.
     - Information first: the service name is the title, practical facts sit in a <dl> (.facts).
     - Sections are separated by a dark 2px rule (.sec), not by cards or coloured bands.
     - Azzurro = action only (one .btn-primary per view) and nothing else.
     - No decorative icons, badges, gradients or scroll animation. Motion only confirms an interaction.
     ========================================================================== */
  :root {
    /* Colour: "Azzurro clinico", deep blue + azzurro on cool white */
    --brand: #1f6a9a;        /* links, labels, selected states: 5.6:1 on --bg */
    --brand-dark: #12385a;   /* headings, section rules, footer */
    --brand-soft: #e3f0f8;   /* selected tiles, booking summary */
    --accent: #1f78b4;       /* azzurro, primary action only: 4.8:1 with white text (--on-accent) */
    --accent-dark: #18669a;  /* hover: 6.2:1 with white text */
    --on-accent: #ffffff;
    --text: #1a2430;
    --muted: #566676;        /* 5.6:1 on --bg */
    --line: #dbe5ec;         /* hairlines between rows (decorative) */
    --rule: var(--brand-dark); /* 2px section rule */
    --line-control: #7f93a3; /* edges of inputs and selectable tiles: ≥3:1 on white and on --bg */
    --bg: #f7fafc;
    --card: #ffffff;         /* form surface only */
    --skeleton-hi: #eef4f8;
    --on-dark: #ffffff;
    --on-dark-soft: #cfe0ee;
    --danger: #b3261e;
    --danger-soft: #fdecea;
    --danger-text: #8c1d18;
    --notice-soft: #fff7d6;
    --focus: var(--brand);

    /* Spacing: 4 px base */
    --space-1: 4px;  --space-2: 8px;  --space-3: 12px; --space-4: 16px; --space-5: 20px;
    --space-6: 24px; --space-8: 32px; --space-10: 40px; --space-12: 48px; --space-16: 64px;
    --gutter: var(--space-4);

    /* Type: Inter only. Body 17 px / 1.6 for the warmth of a printed leaflet.
       Sizes are rem (×16 px at the default) so they follow the reader's browser/OS text size;
       fluid sizes keep a rem part so they still grow when text is enlarged. */
    --fs-xs: 0.8125rem; --fs-sm: 0.9375rem; --fs-body: 1.0625rem; --fs-md: 1.125rem; --fs-lead: 1.1875rem;
    --fs-h3: 1.1875rem;
    --fs-h2: clamp(1.375rem, 1rem + 1.2vw, 1.75rem);
    --fs-h1: clamp(1.875rem, 1rem + 3.6vw, 3.25rem);
    --fw-medium: 550; --fw-semibold: 650; --fw-bold: 750; --fw-black: 800;
    --measure: 68ch;                          /* reading column */

    /* Shape: small, precise corners */
    --radius-s: 8px;    /* inputs, selectable tiles */
    --radius-m: 10px;   /* buttons, notes */
    --radius-l: 14px;   /* form surface, confirmation */

    /* Motion: short, only to confirm what happened */
    --dur-fast: 120ms;
    --dur: 200ms;
    --ease: cubic-bezier(.2, .8, .2, 1);

    --header-h: 3.75rem;
    --mbar-space: 0px;
    font-family: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    /* Scale the fallback font to Inter's x-height (0.546) so text keeps its size when Inter swaps in */
    font-size-adjust: 0.546;
    color: var(--text);
    background: var(--bg);
  }
  @media (width > 51.25em) { :root { --gutter: var(--space-8); } }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { scroll-padding-top: calc(var(--header-h) + var(--space-4)); scroll-padding-bottom: var(--mbar-space); -webkit-text-size-adjust: 100%; }
  /* Motion is opt-in per rule: movement only under no-preference; colour fades stay for everyone */
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  /* Mobile: room for the bottom booking bar */
  @media (width <= 51.25em) { :root { --mbar-space: 76px; } }
  :where(a, button, summary, input, select, textarea, [tabindex]):focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; border-radius: 4px; }
  .skip-link { position: absolute; left: var(--space-3); top: -100px; z-index: 100; background: var(--brand-dark); color: var(--on-dark); padding: var(--space-3) var(--space-5); border-radius: var(--radius-s); font-weight: var(--fw-bold); text-decoration: none; }
  .skip-link:focus { top: var(--space-3); }
  main:focus { outline: none; }
  /* Base size lives on body: the root font size stays the reader's own setting */
  body { margin: 0; font-size: var(--fs-body); line-height: 1.6; -webkit-font-smoothing: antialiased; }
  a { color: var(--brand); text-underline-offset: 3px; }
  a:hover { color: var(--brand-dark); }
  img { max-width: 100%; display: block; }
  .container { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 var(--gutter); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* Headings */
  h1, h2, h3 { color: var(--brand-dark); line-height: 1.15; letter-spacing: -0.02em; text-wrap: balance; overflow-wrap: break-word; font-weight: var(--fw-bold); }
  h1 { font-size: var(--fs-h1); letter-spacing: -0.03em; margin: 0 0 var(--space-5); }
  h2 { font-size: var(--fs-h2); margin: 0 0 var(--space-4); }
  h3 { font-size: var(--fs-h3); margin: 0 0 var(--space-2); letter-spacing: -0.01em; }
  p, li, dd { text-wrap: pretty; }
  /* Small line above a page title: where / what this page is */
  .kicker { margin: 0 0 var(--space-3); font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--brand); }
  .lead { font-size: var(--fs-lead); color: var(--muted); max-width: 40em; margin: 0; }

  /* Buttons: one primary (azzurro) per view, everything else outlined */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 48px; padding: 0 var(--space-5); border-radius: var(--radius-m); font: inherit; font-size: var(--fs-body); font-weight: var(--fw-semibold); line-height: 1.2; text-decoration: none; cursor: pointer; border: 2px solid var(--brand); color: var(--brand-dark); background: transparent; transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease); }
  .btn:hover { background: var(--brand-soft); color: var(--brand-dark); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: var(--fw-bold); }
  .btn-primary:hover { background: var(--accent-dark); border-color: var(--accent-dark); }
  .btn-lg { min-height: 54px; padding: 0 var(--space-6); font-size: var(--fs-md); }
  .btn-block { display: flex; width: 100%; justify-content: space-between; }
  /* Inline text link with an icon; wraps like text so the icon stays next to the last word */
  .arrow-link { display: inline-block; padding: 10px 0; font-weight: var(--fw-semibold); color: var(--brand-dark); }
  .arrow-link .icon { color: var(--brand); vertical-align: -3px; margin: 0 2px; }

  /* ---- Page structure ---- */
  /* Page opening: kicker, title, intro */
  .opening { padding: var(--space-10) 0 var(--space-8); }
  .opening h1 { max-width: 22ch; }
  /* Section: dark rule on top, heading column + content column on desktop */
  .sec { padding: 0 0 var(--space-12); }
  .sec > .container { display: grid; gap: var(--space-4) var(--space-8); }
  .sec > .container::before { content: ''; grid-column: 1 / -1; border-top: 2px solid var(--rule); margin-bottom: var(--space-2); }
  .sec-head h2 { margin: 0; }
  .sec-head p { margin: var(--space-2) 0 0; color: var(--muted); font-size: var(--fs-sm); }
  .sec-body { min-width: 0; max-width: var(--measure); }
  .sec-body > :first-child { margin-top: 0; }
  .sec-body > :last-child { margin-bottom: 0; }
  @media (width > 51.25em) {
    .opening { padding: var(--space-16) 0 var(--space-12); }
    .sec { padding-bottom: var(--space-16); }
    .sec > .container { grid-template-columns: minmax(200px, 1fr) 2.6fr; }
  }

  /* Facts: label / value rows, the core pattern of the site */
  .facts { margin: 0; border-top: 2px solid var(--rule); }
  /* Label and value share a row while the value has ~12rem; with enlarged text the value drops under its label */
  .facts > div { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--line); }
  .facts dt { flex: 0 0 var(--facts-label, 7.5rem); font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--muted); padding-top: 1px; }
  .facts dd { flex: 1 1 12rem; min-width: 0; margin: 0; font-weight: var(--fw-medium); font-variant-numeric: tabular-nums; }
  .facts .facts__big { font-size: 1.5rem; font-weight: var(--fw-bold); color: var(--brand-dark); line-height: 1.2; letter-spacing: -0.01em; }
  .facts small { display: block; font-size: var(--fs-sm); font-weight: 400; color: var(--muted); margin-top: 2px; line-height: 1.45; }

  /* Lists with hairlines (steps, checklists) */
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows > li { padding: var(--space-3) 0; border-bottom: 1px solid var(--line); }
  ol.rows { counter-reset: row; }
  ol.rows > li { counter-increment: row; display: grid; grid-template-columns: 2rem 1fr; }
  ol.rows > li::before { content: counter(row) '.'; font-weight: var(--fw-bold); color: var(--brand); font-variant-numeric: tabular-nums; }

  /* Long-form text (privacy, partner) */
  .prose { max-width: var(--measure); }
  .prose ul { padding-left: 1.2em; }
  .prose li + li { margin-top: var(--space-1); }
  .note { margin: var(--space-4) 0 0; padding: var(--space-3) var(--space-4); border-left: 3px solid var(--brand); background: var(--brand-soft); border-radius: 0 var(--radius-s) var(--radius-s) 0; }
  .muted { color: var(--muted); }
  .small { font-size: var(--fs-sm); }
  .mt-6 { margin-top: var(--space-6); }
  .mt-8 { margin-top: var(--space-8); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-6); }
  @media (width <= 51.25em) { .actions > .btn { flex: 1 1 auto; } }
</style>
