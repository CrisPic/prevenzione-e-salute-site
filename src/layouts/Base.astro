---
import '@fontsource-variable/inter';
import { site } from '../data/site.js';
// schema: optional JSON-LD object or array of objects for this page.
// noindex: force noindex on one page (e.g. 404); site.indexable=false sets it everywhere.
const { title, description, lang = 'it', schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const robots = noindex || !site.indexable ? 'noindex, follow' : null;
const schemas = schema ? [schema].flat() : [];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Lets CSS tell "JS is coming" apart from "no JS" (booking form shows a loading state instead of the fallback) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0f5c63" />
    {site.showEnglish && <link rel="alternate" hreflang="it" href={new URL('/', Astro.site)} />}
    {site.showEnglish && <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />}
    {site.showEnglish && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'it_IT'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Prevenzione e Salute – certificato medico sportivo non agonistico a Milano, €50" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <slot />
  </body>
</html>

<style is:global>
  /* ===== Design system: every component reads these tokens, no raw values elsewhere ===== */
  :root {
    /* Colour (Palette A). Lime = action buttons and the price only. */
    --brand: #0f5c63;
    --brand-dark: #0a3f44;
    --brand-soft: #e3f0f0;
    --accent: #c6f432;
    --accent-dark: #a8d61a;
    --text: #1b2426;
    --muted: #5b6b6e;
    --line: #dde7e7;
    --line-strong: #9fc6c6;
    --bg: #f6f9f9;
    --card: #ffffff;
    --on-dark: #ffffff;
    --on-dark-muted: #a9cfcf;
    --on-dark-soft: #cfe3e3;
    --danger: #b3261e;
    --danger-soft: #fdecea;
    --danger-text: #8c1d18;
    --notice-soft: #fff7d6;
    --focus: var(--brand);

    /* Spacing: 4 px base */
    --space-1: 4px;  --space-2: 8px;  --space-3: 12px; --space-4: 16px; --space-5: 20px;
    --space-6: 24px; --space-8: 32px; --space-10: 40px; --space-12: 48px; --space-16: 64px; --space-20: 80px;

    /* Type */
    --fs-xs: 13px; --fs-sm: 14px; --fs-body: 16px; --fs-md: 18px; --fs-lead: 19px;
    --fs-h3: 21px; --fs-h2: clamp(26px, 4vw, 36px); --fs-h1: clamp(34px, 5.4vw, 56px); --fs-h1-page: clamp(32px, 5vw, 48px);
    --fw-medium: 550; --fw-semibold: 650; --fw-bold: 750; --fw-black: 800;

    /* Shape. Nested corners: outer radius = inner radius + padding */
    --radius-s: 12px;   /* inner: tiles, inputs, notes inside cards */
    --radius-m: 20px;   /* standalone cards without nested shapes */
    --radius-l: 28px;   /* large surfaces */
    --radius-pill: 999px;
    --pad-card: 20px;
    --radius-card: calc(var(--radius-s) + var(--pad-card)); /* 32px: card that holds radius-s children */
    --radius: var(--radius-m);
    --tile-s: 40px;
    --tile-m: 48px;
    --shadow-float: 0 8px 24px rgba(10, 63, 68, .3);

    /* Motion: short, only to confirm what happened */
    --dur-fast: 120ms;
    --dur: 220ms;
    --ease: cubic-bezier(.2, .8, .2, 1);

    --mbar-space: 0px;
    font-family: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--text);
    background: var(--bg);
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; scroll-padding-bottom: var(--mbar-space); }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 1ms !important; animation-iteration-count: 1 !important; transition-duration: 1ms !important; }
  }
  /* Mobile: room for the sticky Prenota / WhatsApp / Chiama bar */
  @media (max-width: 820px) { :root { --mbar-space: 80px; } }
  /* Visible keyboard focus on every link, button and summary */
  :where(a, button, summary, input, select, textarea, [tabindex]):focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; border-radius: 4px; }
  .skip-link { position: absolute; left: var(--space-3); top: -100px; z-index: 100; background: var(--brand-dark); color: var(--on-dark); padding: var(--space-3) var(--space-5); border-radius: var(--radius-s); font-weight: 700; text-decoration: none; }
  .skip-link:focus { top: var(--space-3); }
  main:focus { outline: none; }
  body { margin: 0; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  a { color: var(--brand); }
  img { max-width: 100%; display: block; }
  .container { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 var(--space-4); }
  .nowrap { white-space: nowrap; }

  /* Buttons: one primary (lime) per view, everything else outlined */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 48px; padding: 0 var(--space-6); border-radius: var(--radius-pill); font: inherit; font-weight: var(--fw-semibold); line-height: 1.2; text-decoration: none; cursor: pointer; border: 2px solid var(--brand); color: var(--brand); background: transparent; transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease); }
  .btn:hover { background: var(--brand-soft); }
  .btn:active { transform: scale(.97); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--brand-dark); }
  .btn-primary:hover { background: var(--accent-dark); border-color: var(--accent-dark); }
  .btn-lg { min-height: 56px; padding: 0 var(--space-8); font-size: var(--fs-md); font-weight: var(--fw-bold); }
  .btn .icon { transition: transform var(--dur-fast) var(--ease); }
  .btn:hover .icon { transform: translateX(3px); }
  .text-link { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; font-weight: var(--fw-semibold); text-underline-offset: 3px; }
  .text-link .icon { transition: transform var(--dur-fast) var(--ease); }
  .text-link:hover .icon { transform: translateX(3px); }

  /* Headings wrap into balanced lines; paragraphs avoid one-word last lines */
  h1, h2, h3 { color: var(--brand-dark); line-height: 1.15; letter-spacing: -0.02em; text-wrap: balance; }
  p, li, dd { text-wrap: pretty; }
  h2 { font-size: var(--fs-h2); margin: 0 0 var(--space-6); }
  /* Heading + its intro read as one group, then a clear gap to the content */
  .section-head { margin-bottom: var(--space-8); }
  .section-head h2 { margin-bottom: var(--space-2); }
  .section-head p { margin: 0; color: var(--muted); max-width: 640px; }
  section { padding: var(--space-16) 0; }
  @media (max-width: 820px) { section { padding: var(--space-12) 0; } }
</style>
