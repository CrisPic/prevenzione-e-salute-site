---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
// Inner pages: kicker (optional), title, intro, then .sec sections in the slot
const { title, description, heading, intro, kicker, schema, noindex } = Astro.props;
---
<Base title={title} description={description} schema={schema} noindex={noindex}>
  <Header />
  <main id="main" tabindex="-1">
    <div class="opening">
      <div class="container">
        {kicker && <p class="kicker">{kicker}</p>}
        <h1>{heading}</h1>
        {intro && <p class="lead">{intro}</p>}
        <slot name="opening" />
      </div>
    </div>
    <slot />
  </main>
  <Footer />
  <MobileBar />
</Base>
