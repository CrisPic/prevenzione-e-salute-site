---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
const { title, description, heading, intro, schema, noindex } = Astro.props;
---
<Base title={title} description={description} schema={schema} noindex={noindex}>
  <Header />
  <main id="main" tabindex="-1">
    <section class="page-hero">
      <div class="container">
        <h1>{heading}</h1>
        {intro && <p class="intro">{intro}</p>}
      </div>
    </section>
    <slot />
  </main>
  <Footer />
  <MobileBar />
</Base>

<style>
  .page-hero { padding: var(--space-12) 0 0; }
  h1 { font-size: var(--fs-h1-page); margin: 0 0 var(--space-3); max-width: 20ch; }
  .intro { font-size: var(--fs-lead); color: var(--muted); max-width: 640px; margin: 0; }
  @media (max-width: 820px) { .page-hero { padding-top: var(--space-8); } }
</style>
<style is:global>
  /* Inner pages: first content section sits close to the page heading */
  .page-hero + section { padding-top: var(--space-10); }
  /* Reading column, but left-aligned with the page heading (not centred) */
  .prose > * { max-width: 760px; }
  .prose h2 { font-size: 24px; margin: var(--space-12) 0 var(--space-4); }
  .prose > h2:first-child { margin-top: 0; }
  .prose p, .prose li { color: var(--text); }
  .stack { display: grid; gap: var(--space-5); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-6); }
  .note { padding: var(--space-4) var(--space-5); background: var(--brand-soft); border-radius: var(--radius-m); }
  .hint { color: var(--muted); font-size: var(--fs-sm); margin: var(--space-2) 0 0; }
  @media (max-width: 820px) { .actions .btn { flex: 1 1 auto; } }
</style>
