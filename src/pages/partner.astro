---
import Page from '../layouts/Page.astro';
import { site } from '../data/site.js';
import StepTimeline from '../components/StepTimeline.astro';
const mail = site.email ? `mailto:${site.email}?subject=Certificati%20per%20gruppi` : '/contatti/';
---
<Page title="Certificati sportivi per palestre e aziende | Prevenzione e Salute" description="Visite per gruppi per il certificato medico sportivo non agonistico: palestre, associazioni sportive, scuole di danza e aziende a Milano. Date dedicate." heading="Certificati medici per i suoi iscritti o dipendenti" intro="Organizziamo visite per gruppi, nello studio di Via Piacenza 4 o in giornate dedicate concordate con la sua struttura.">
  <section>
    <div class="container prose">
      <h2>A chi si rivolge</h2>
      <ul>
        <li>Palestre e centri fitness</li>
        <li>Associazioni e società sportive dilettantistiche</li>
        <li>Scuole di danza, arti marziali, nuoto</li>
        <li>Aziende con attività sportive o di benessere per i dipendenti</li>
      </ul>
      <h2>Dalla richiesta alla visita</h2>
      <StepTimeline steps={[
        'Ci contatta con numero di persone e periodo.',
        'Concordiamo date e orari dedicati.',
        'Gli iscritti prenotano lo slot con un link riservato.',
        "Il certificato viene rilasciato al termine della visita, se il medico conferma l'idoneità.",
      ]} />
      <p><strong>Condizioni per gruppi:</strong> su richiesta.</p>
      <div class="request">
        <p>Ci indichi nome della struttura, referente, email, telefono e numero indicativo di persone.</p>
        <a class="btn btn-primary btn-lg" href={mail}>Richiedi informazioni</a>
      </div>
    </div>
  </section>
</Page>

<style>
  /* Instructions and the action they lead to, as one group */
  .request { margin-top: var(--space-8); padding: var(--pad-card); border-radius: var(--radius-card); background: var(--card); border: 1px solid var(--line); }
  .request p { margin: 0 0 var(--space-4); color: var(--muted); }
  @media (max-width: 820px) { .request .btn { width: 100%; } }
</style>
