---
import Page from '../layouts/Page.astro';
import { site } from '../data/site.js';
import InfoCallout from '../components/InfoCallout.astro';
import BookingForm from '../components/BookingForm.astro';
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}` : '';
---
<Page title="Prenota la visita | Prevenzione e Salute – Milano" description="Prenoti online il certificato medico sportivo non agonistico o ludico-motorio (€50) o una visita medica specialistica presso GetFIT, Via Piacenza 4, Milano." heading="Prenoti la sua visita" intro="Scelga servizio, giorno e orario. Riceverà una conferma via email.">
  <section>
    <div class="container prose">
      <BookingForm />
      {(wa || site.phone) && (
        <>
          <h2>Preferisce scriverci o chiamare?</h2>
          <div class="actions">
            {wa && <a class="btn" href={wa}>Ci scriva su WhatsApp</a>}
            {site.phone && <a class="btn" href={`tel:${site.phone}`}>Ci chiami: {site.phone}</a>}
          </div>
        </>
      )}
      <h2>Disdire o spostare un appuntamento</h2>
      <p>Usi il link nell'email di conferma{wa ? ' oppure ci scriva su WhatsApp' : ''}, possibilmente almeno 24 ore prima.</p>
      <InfoCallout icon="shield" tone="white"><p>Nel modulo chiediamo solo nome, telefono, email e servizio. Non inserisca informazioni sulla sua salute.</p></InfoCallout>
    </div>
  </section>
</Page>
