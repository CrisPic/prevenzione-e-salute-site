---
import Page from '../layouts/Page.astro';
import { site } from '../data/site.js';
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}` : '';
---
<Page title="Prenota la visita | Prevenzione e Salute – Milano" description="Prenoti online il certificato medico sportivo non agonistico presso GetFIT, Via Piacenza 4, Milano." eyebrow="Prenota" heading="Prenoti la sua visita" intro="Scelga servizio, giorno e orario. Riceverà una conferma via email e un promemoria il giorno prima.">
  <section>
    <div class="container prose">
      {site.bookingUrl
        ? <iframe src={site.bookingUrl} title="Calendario di prenotazione" style="width:100%;min-height:720px;border:1px solid var(--line);border-radius:16px;background:#fff" loading="lazy"></iframe>
        : <p class="note">Il calendario di prenotazione online è in arrivo. Nel frattempo può prenotare su WhatsApp o per telefono.</p>}
      <h2>Preferisce scriverci o chiamare?</h2>
      <div class="actions">
        <a class="btn btn-dark" href={wa || '/contatti'}>Scrivici su WhatsApp</a>
        <a class="btn" href={site.phone ? `tel:${site.phone}` : '/contatti'}>Chiama{site.phone ? `: ${site.phone}` : ''}</a>
      </div>
      <h2>Disdire o spostare un appuntamento</h2>
      <p>Usi il link nell'email di conferma oppure ci scriva su WhatsApp, possibilmente almeno 24 ore prima.</p>
      <p><em>Nel modulo chiediamo solo nome, telefono, email e servizio. Non inserisca informazioni sulla sua salute.</em></p>
    </div>
  </section>
</Page>
