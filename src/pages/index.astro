---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import PriceList from '../components/PriceList.astro';
import Icon from '../components/Icon.astro';
import { site, serviceInfo, clinicSchema } from '../data/site.js';

const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
const audience = [
  'Iscritti in palestra e corsi fitness',
  'Sportivi amatoriali: corsa, ciclismo, padel, nuoto',
  'Bambini e ragazzi che praticano sport',
  'Palestre, associazioni e aziende',
];
const steps = [
  ({ 'wa+tel': 'Prenoti online, su WhatsApp o per telefono.', wa: 'Prenoti online o su WhatsApp.', tel: 'Prenoti online o per telefono.', none: 'Prenoti online scegliendo giorno e orario.' })[site.whatsapp && site.phone ? 'wa+tel' : site.whatsapp ? 'wa' : site.phone ? 'tel' : 'none'],
  "Si presenti con documento d'identità e tessera sanitaria.",
  'La visita dura circa 10 minuti.',
  "Il certificato viene rilasciato al termine della visita, se il medico conferma l'idoneità.",
];
---
<Base
  title="Certificato medico sportivo a Milano – €50 | Prevenzione e Salute"
  description="Certificato medico sportivo non agonistico a €50 nello studio medico dentro GetFIT, Via Piacenza 4, Milano. Visita di circa 10 minuti, certificato al termine della visita se il medico conferma l'idoneità."
  schema={clinicSchema(Astro.site)}>
  <Header />
  <main id="main" tabindex="-1">
    <nav class="toc" aria-label="In questa pagina">
      <div class="container toc__row">
        <a href="#servizi">Servizi e prezzi</a><a href="#come-funziona">Come funziona</a><a href="#dove">Dove</a>
      </div>
    </nav>

    <div class="opening">
      <div class="container hero">
        <p class="kicker hero__kicker">Studio medico · Certificati e visite</p>
        <h1 class="hero__title">Certificato medico sportivo non agonistico a Milano</h1>
        <dl class="facts hero__facts">
          <div><dt>Prezzo</dt><dd class="facts__big">€{site.certificatePrice}</dd></div>
          <div><dt>Visita</dt><dd>Circa 10 minuti</dd></div>
          <div><dt>Validità</dt><dd>12 mesi<small>Il certificato viene rilasciato al termine della visita, se il medico conferma l'idoneità.</small></dd></div>
          <div><dt>Dove</dt><dd>{site.address}<small>{site.venue}</small></dd></div>
          <div><dt>Da portare</dt><dd>Documento d'identità e tessera sanitaria</dd></div>
        </dl>
        <div class="hero__cta">
          <a class="btn btn-primary btn-lg btn-block" href={`${bookHref}?servizio=certificato`} data-primary-cta>Prenoti la visita <Icon name="arrow" size={20} /></a>
          <p class="small muted">Prenotazione online anche per il certificato ludico-motorio e le visite specialistiche.</p>
        </div>
      </div>
    </div>

    <section class="sec" id="servizi" aria-labelledby="servizi-h">
      <div class="container">
        <div class="sec-head">
          <h2 id="servizi-h">Servizi e prezzi</h2>
          <p>Prevenzione e Salute si avvale di professionisti qualificati.</p>
        </div>
        <div class="sec-body">
          <PriceList items={serviceInfo} />
          <p class="small muted">Lo studio non rilascia il certificato agonistico.</p>
          <a class="arrow-link" href="/servizi/#domande">Differenze tra i certificati e domande frequenti <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </section>

    <section class="sec" id="come-funziona" aria-labelledby="come-h">
      <div class="container">
        <div class="sec-head"><h2 id="come-h">Come funziona</h2></div>
        <div class="sec-body">
          <ol class="rows">{steps.map((s) => <li>{s}</li>)}</ol>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="chi-h">
      <div class="container">
        <div class="sec-head"><h2 id="chi-h">Per chi fa sport, a ogni età</h2></div>
        <div class="sec-body">
          <ul class="rows">{audience.map((a) => <li>{a}</li>)}</ul>
          <div class="actions"><a class="btn" href="/partner/">Visite per gruppi: palestre e aziende</a></div>
        </div>
      </div>
    </section>

    <section class="sec" id="dove" aria-labelledby="dove-h">
      <div class="container">
        <div class="sec-head"><h2 id="dove-h">Dove</h2></div>
        <div class="sec-body">
          <dl class="facts">
            <div><dt>Indirizzo</dt><dd>{site.address}</dd></div>
            <div><dt>Studio</dt><dd>{site.venue}</dd></div>
            <div><dt>Orari</dt><dd>{site.hours || 'In arrivo'}</dd></div>
          </dl>
          <a class="arrow-link" href={site.mapsUrl}><Icon name="pin" size={18} /> Indicazioni stradali su Google Maps</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <MobileBar />
</Base>

<style>
  /* Page index: phones only, the header nav covers desktop */
  .toc { border-bottom: 1px solid var(--line); }
  .toc__row { display: flex; padding: 0; }
  .toc a { flex: 1 1 0; display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 var(--space-2); font-size: var(--fs-xs); font-weight: var(--fw-semibold); color: var(--brand-dark); text-decoration: none; text-align: center; line-height: 1.2; }
  .toc a + a { border-left: 1px solid var(--line); }
  .toc a:hover { background: var(--brand-soft); }
  @media (width > 51.25em) { .toc { display: none; } }

  .opening { padding-top: var(--space-6); }
  .hero { display: grid; grid-template-areas: 'kicker' 'title' 'facts' 'cta'; }
  .hero__kicker { grid-area: kicker; }
  .hero__title { grid-area: title; max-width: 18ch; }
  .hero__facts { grid-area: facts; }
  .hero__cta { grid-area: cta; margin-top: var(--space-5); }
  .hero__cta p { margin: var(--space-3) 0 0; }
  .sec-body > .small { margin: var(--space-4) 0 var(--space-1); }
  .sec-body > .arrow-link { margin-top: var(--space-2); }

  @media (width > 51.25em) {
    .opening { padding-top: var(--space-16); }
    .hero { grid-template-columns: 1.15fr 1fr; grid-template-rows: auto auto 1fr; grid-template-areas: 'kicker facts' 'title facts' 'cta facts'; column-gap: var(--space-16); }
    .hero__cta { align-self: start; margin-top: var(--space-2); max-width: 26rem; }
    .hero__facts { align-self: start; }
  }
</style>
