---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import PriceCard from '../components/PriceCard.astro';
import ServiceRow from '../components/ServiceRow.astro';
import StepTimeline from '../components/StepTimeline.astro';
import Icon from '../components/Icon.astro';
import { site, clinicSchema } from '../data/site.js';

const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}` : ''; // shown only when the number exists

const services = [
  { i: 'certificate', t: 'Certificato medico per attività sportiva non agonistica', p: '€50', d: 'Per lo sport praticato con società e associazioni sportive e per le attività sportive parascolastiche. Valido 12 mesi.' },
  { i: 'certificate', t: 'Certificato medico per attività ludico-motoria', p: '€50', d: 'Per attività fisica amatoriale e ricreativa, ad esempio in palestra o nei corsi fitness, quando la struttura lo richiede. Valido 12 mesi.' },
  { i: 'stethoscope', t: 'Visite mediche specialistiche', p: 'Su richiesta', d: 'Visite con medici specialisti presso lo studio, prenotabili online.' },
];
const audience = [
  'Iscritti in palestra e corsi fitness',
  'Sportivi amatoriali: corsa, ciclismo, padel, nuoto',
  'Bambini e ragazzi che praticano sport',
  'Palestre, associazioni e aziende',
];
const steps = [
  ({ 'wa+tel': 'Prenoti online, su WhatsApp o per telefono.', wa: 'Prenoti online o su WhatsApp.', tel: 'Prenoti online o per telefono.', none: 'Prenoti online scegliendo giorno e orario.' })[site.whatsapp && site.phone ? 'wa+tel' : site.whatsapp ? 'wa' : site.phone ? 'tel' : 'none'],
  "Si presenti con documento d'identità e tessera sanitaria.",
  'Visita di circa 10 minuti.',
  "Il certificato viene rilasciato al termine della visita, se il medico conferma l'idoneità.",
];
---
<Base
  title="Certificato medico sportivo a Milano – €50 | Prevenzione e Salute"
  description="Certificato medico sportivo non agonistico a €50 nello studio medico dentro GetFIT, Via Piacenza 4, Milano. Visita di circa 10 minuti, certificato al termine della visita se il medico conferma l'idoneità."
  schema={clinicSchema(Astro.site)}>
  <Header />
  <main id="main" tabindex="-1">
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <h1>Certificato medico sportivo non agonistico a Milano</h1>
          <p class="lead">Nello studio medico al primo piano di GetFIT, in <span class="nowrap">Via Piacenza 4</span>.</p>
          <div class="actions">
            <a class="btn btn-primary btn-lg" href={bookHref}>Prenota online <Icon name="arrow" size={20} /></a>
            {wa && <a class="btn btn-lg" href={wa}>Ci scriva su WhatsApp</a>}
          </div>
          <p class="cta-hint">Scelga giorno e orario dal calendario online.</p>
        </div>
        <PriceCard
          label="Certificato non agonistico o ludico-motorio"
          price={`€${site.certificatePrice}`}
          facts={[
            { label: 'Durata visita', value: 'Circa 10 min' },
            { label: 'Validità', value: '12 mesi' },
          ]}
          note={"Il certificato viene rilasciato al termine della visita, se il medico conferma l'idoneità."}
        />
      </div>
    </section>

    <section id="servizi" class="services">
      <div class="container">
        <div class="section-head">
          <h2>Certificati sportivi e visite specialistiche</h2>
          <p>Prevenzione e Salute si avvale di professionisti qualificati.</p>
        </div>
        <div class="services-grid">
          {services.map((s, i) => (
            <ServiceRow icon={s.i} title={s.t} price={s.p} description={s.d} featured={i === 0}>
              {i === 0 && <a class="btn btn-primary btn-lg feature-cta" href={`${bookHref}?servizio=certificato`}>Prenota il certificato <Icon name="arrow" size={20} /></a>}
            </ServiceRow>
          ))}
        </div>
        <a class="text-link more" href="/servizi/">Dettagli e domande frequenti <Icon name="arrow" size={20} /></a>
      </div>
    </section>

    <section class="band">
      <div class="container two">
        <div>
          <h2>Per chi fa sport, a ogni età</h2>
          <ul class="checks">
            {audience.map((a) => <li><span class="check"><Icon name="check" size={14} /></span>{a}</li>)}
          </ul>
          <a class="btn" href="/partner/">Visite per gruppi: palestre e aziende</a>
        </div>
        <div>
          <h2>Dalla prenotazione al certificato</h2>
          <StepTimeline steps={steps} />
        </div>
      </div>
    </section>

    <section id="dove">
      <div class="container where">
        <div>
          <h2>Al primo piano di GetFIT, in <span class="nowrap">Via Piacenza 4</span></h2>
          <p class="address">{site.address}<br /><strong>Orari:</strong> in arrivo</p>
          <div class="actions">
            <a class="btn btn-primary" href={bookHref}>Prenota online</a>
            <a class="btn" href={site.mapsUrl}><Icon name="pin" size={20} /> Indicazioni stradali</a>
          </div>
        </div>
        <div class="photo" role="img" aria-label="Foto esterna di GetFIT (in arrivo)"><span>Foto esterna GetFIT</span></div>
      </div>
    </section>
  </main>
  <Footer />
  <MobileBar />
</Base>

<style>
  .hero { padding: var(--space-16) 0 var(--space-12); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-12); align-items: center; }
  /* Big heading: tiny left pull so the H's stem lines up with the text below by eye */
  h1 { font-size: var(--fs-h1); margin: 0 0 var(--space-4) -0.03em; }
  .lead { font-size: var(--fs-lead); color: var(--muted); max-width: 520px; margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .cta-hint { margin: var(--space-3) 0 0; font-size: var(--fs-sm); color: var(--muted); }

  .services { padding-top: var(--space-12); }
  /* The certificate is the main feature: it takes the tall left column */
  .services-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: var(--space-5); }
  .services-grid > :global(.service--featured) { grid-row: span 2; }
  .more { margin-top: var(--space-4); }
  .feature-cta { align-self: flex-start; margin-top: var(--space-3); }

  .band { background: var(--card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-16); }
  /* Both columns share row lines, so the list and the steps start at the same height even if a heading wraps */
  .two > div { display: grid; grid-row: span 3; grid-template-rows: subgrid; align-content: start; }
  .two > div > :global(.btn) { justify-self: start; }
  .checks { list-style: none; padding: 0; margin: 0 0 var(--space-6); }
  .checks li { display: flex; align-items: center; gap: var(--space-3); min-height: 48px; padding: var(--space-2) 0; border-bottom: 1px solid var(--line); }
  .check { flex: 0 0 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--brand-soft); color: var(--brand); }

  .where { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
  .where h2 { margin-bottom: var(--space-3); }
  .address { margin: 0; }
  .photo { aspect-ratio: 4 / 3; border-radius: var(--radius-l); background: var(--brand-soft); display: grid; place-items: center; color: var(--muted); font-weight: 600; }

  @media (max-width: 820px) {
    .hero { padding: var(--space-8) 0 var(--space-10); }
    .hero-grid, .two, .where { grid-template-columns: 1fr; gap: var(--space-8); }
    .services-grid { grid-template-columns: 1fr; }
    .services-grid > :global(.service--featured) { grid-row: auto; }
    .two > div { grid-row: auto; grid-template-rows: none; }
    .two { row-gap: var(--space-12); }
    .feature-cta { align-self: stretch; }
    .actions .btn { flex: 1 1 auto; }
    .cta-hint { text-align: center; }
  }
</style>
