---
import Page from '../layouts/Page.astro';
import ServiceRow from '../components/ServiceRow.astro';
import FaqItem from '../components/FaqItem.astro';
const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
const services = [
  { i: 'certificate', t: 'Certificato medico sportivo non agonistico', p: '€50', d: "Necessario per svolgere attività sportiva non agonistica presso palestre, associazioni e società sportive, e per le attività sportive parascolastiche. La visita comprende anamnesi, esame obiettivo e misurazione della pressione. Il certificato è valido 12 mesi dalla data di rilascio." },
  { i: 'gauge', t: 'Misurazione della pressione arteriosa', p: 'Su richiesta', d: 'Controllo rapido della pressione, utile per chi si allena o vuole monitorarla nel tempo.' },
  { i: 'stethoscope', t: 'Controlli di salute di base e prescrizioni', p: 'Su richiesta', d: 'Una visita di medicina generale per fare il punto sul proprio stato di salute. Comprende colloquio sulla storia clinica e sugli stili di vita, esame obiettivo, misurazione di pressione arteriosa e frequenza cardiaca, peso e indice di massa corporea (BMI). Se necessario, il medico prescrive esami del sangue o accertamenti specialistici e ne valuta i risultati in una visita successiva.' },
];
const faq = [
  ['Quanto dura il certificato?', '12 mesi dalla data di rilascio.'],
  ['Quanto dura la visita?', 'Circa 20–30 minuti.'],
  ["Che differenza c'è con il certificato agonistico?", "L'agonistico serve per le gare ufficiali delle federazioni e richiede una visita dal medico specialista in medicina dello sport. Lo studio rilascia solo il certificato non agonistico."],
  ['Posso venire senza prenotazione?', "Sì, negli orari di apertura, ma la prenotazione online garantisce l'orario."],
  ['Anche per bambini e ragazzi?', 'Sì, con la presenza di un genitore o tutore.'],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Page schema={faqSchema} title="Servizi e prezzi: certificato sportivo €50 | Prevenzione e Salute" description="Certificato medico sportivo non agonistico €50, misurazione della pressione e controlli di salute di base presso GetFIT, Via Piacenza 4, Milano." eyebrow="Servizi" heading="Servizi e prezzi" intro="Tutte le visite si svolgono nello studio medico al primo piano di GetFIT, in Via Piacenza 4.">
  <section>
    <div class="container stack">
      {services.map((s, i) => (
        <ServiceRow icon={s.i} title={s.t} price={s.p} description={s.d} featured={i === 0} headingLevel={2} />
      ))}
      <div class="actions"><a class="btn btn-primary" href={bookHref}>Prenota online</a></div>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="container prose">
      <h2>Cosa portare alla visita</h2>
      <ul>
        <li>Documento d'identità e tessera sanitaria</li>
        <li>Eventuali referti o esami recenti</li>
        <li>Per i minori: presenza di un genitore o tutore</li>
      </ul>
      <h2>Domande frequenti</h2>
      {faq.map(([q, a]) => <FaqItem q={q} a={a} />)}
    </div>
  </section>
</Page>
