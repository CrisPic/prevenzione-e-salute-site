---
import Page from '../layouts/Page.astro';
import ServiceRow from '../components/ServiceRow.astro';
import FaqItem from '../components/FaqItem.astro';
const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
const services = [
  { i: 'certificate', t: 'Certificato medico per attività sportiva non agonistica', p: '€50', d: "Necessario per l'attività sportiva non agonistica praticata con società e associazioni sportive, anche in palestra, e per le attività sportive parascolastiche. La visita dura circa 10 minuti e comprende anamnesi, esame obiettivo e misurazione della pressione. Il certificato viene rilasciato al termine della visita, se il medico conferma l'idoneità. Il certificato è valido 12 mesi dalla data di rilascio." },
  { i: 'file', t: 'Certificato medico per attività ludico-motoria', p: 'Su richiesta', d: "Per l'attività fisica amatoriale e ricreativa svolta al di fuori di società e associazioni sportive, ad esempio in palestra o nei corsi fitness, quando la struttura lo richiede. Non vale per l'attività sportiva organizzata né per le gare. Per informazioni e prenotazione ci contatti." },
  { i: 'gauge', t: 'Misurazione della pressione arteriosa', p: 'Su richiesta', d: 'Controllo rapido della pressione, utile per chi si allena o vuole monitorarla nel tempo.' },
  { i: 'stethoscope', t: 'Controlli di salute di base e prescrizioni', p: 'Su richiesta', d: 'Una visita di medicina generale per fare il punto sul proprio stato di salute. Comprende colloquio sulla storia clinica e sugli stili di vita, esame obiettivo, misurazione di pressione arteriosa e frequenza cardiaca, peso e indice di massa corporea (BMI). Se necessario, il medico prescrive esami del sangue o accertamenti specialistici e ne valuta i risultati in una visita successiva.' },
  { i: 'info', t: 'Visite mediche specialistiche', p: '', d: "Visite con medici specialisti presso lo studio. Le specialità disponibili e le modalità di prenotazione vengono comunicate su richiesta: ci contatti per informazioni." },
];
const faq = [
  ['Quanto dura il certificato non agonistico?', '12 mesi dalla data di rilascio.'],
  ['Quanto dura la visita per il certificato non agonistico?', "Circa 10 minuti. Il certificato viene rilasciato al termine della visita, se il medico conferma l'idoneità."],
  ["Che differenza c'è con il certificato agonistico?", "L'agonistico serve per le gare ufficiali delle federazioni e richiede una visita dal medico specialista in medicina dello sport. Lo studio non rilascia il certificato agonistico."],
  ["Che differenza c'è tra certificato non agonistico e ludico-motorio?", "Il non agonistico serve per lo sport praticato con società e associazioni sportive e per le attività sportive parascolastiche. Il ludico-motorio riguarda l'attività fisica amatoriale e ricreativa, ad esempio in palestra, quando la struttura lo richiede."],
  ['Posso venire senza prenotazione?', "Sì, negli orari di apertura, ma la prenotazione online garantisce l'orario."],
  ['Anche per bambini e ragazzi?', 'Sì, con la presenza di un genitore o tutore.'],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Page schema={faqSchema} title="Servizi e prezzi: certificato sportivo €50 | Prevenzione e Salute" description="Certificato medico sportivo non agonistico €50, certificato per attività ludico-motoria, misurazione della pressione, controlli di salute e visite specialistiche presso GetFIT, Via Piacenza 4, Milano." eyebrow="Servizi" heading="Servizi e prezzi" intro="Tutte le visite si svolgono nello studio medico al primo piano di GetFIT, in Via Piacenza 4.">
  <section>
    <div class="container stack">
      {services.map((s, i) => (
        <ServiceRow icon={s.i} title={s.t} price={s.p} description={s.d} featured={i === 0} headingLevel={2} />
      ))}
      <div class="actions"><a class="btn btn-primary" href={bookHref}>Prenota online</a></div>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="container prose">
      <h2>Cosa portare alla visita</h2>
      <ul>
        <li>Documento d'identità e tessera sanitaria</li>
        <li>Eventuali referti o esami recenti</li>
        <li>Per i minori: presenza di un genitore o tutore</li>
      </ul>
      <h2>Domande frequenti</h2>
      {faq.map(([q, a]) => <FaqItem q={q} a={a} />)}
    </div>
  </section>
</Page>
