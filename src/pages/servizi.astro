---
import Page from '../layouts/Page.astro';
import PriceList from '../components/PriceList.astro';
import FaqItem from '../components/FaqItem.astro';
import Icon from '../components/Icon.astro';
import { serviceInfo } from '../data/site.js';
const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
const faq = [
  ['Quanto dura il certificato?', 'Il certificato non agonistico e quello ludico-motorio valgono 12 mesi dalla data di rilascio.'],
  ['Quanto dura la visita per il certificato?', "Circa 10 minuti. Il certificato viene rilasciato al termine della visita, se il medico conferma l'idoneità."],
  ["Che differenza c'è con il certificato agonistico?", "L'agonistico serve per le gare ufficiali delle federazioni e richiede una visita dal medico specialista in medicina dello sport. Lo studio non rilascia il certificato agonistico."],
  ["Che differenza c'è tra certificato non agonistico e ludico-motorio?", "Il non agonistico serve per lo sport praticato con società e associazioni sportive e per le attività sportive parascolastiche. Il ludico-motorio riguarda l'attività fisica amatoriale e ricreativa, ad esempio in palestra, quando la struttura lo richiede."],
  ['Posso venire senza prenotazione?', "Sì, negli orari di apertura, ma la prenotazione online garantisce l'orario."],
  ['Anche per bambini e ragazzi?', 'Sì, con la presenza di un genitore o tutore.'],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Page schema={faqSchema} title="Servizi e prezzi: certificato sportivo €50 | Prevenzione e Salute" description="Certificato medico sportivo non agonistico e certificato per attività ludico-motoria €50 e visite mediche specialistiche presso GetFIT, Via Piacenza 4, Milano." kicker="Servizi e prezzi" heading="Certificati sportivi e visite specialistiche" intro="Prezzi, durata della visita e cosa portare. Lo studio è al primo piano di GetFIT, in Via Piacenza 4.">
  <section class="sec" aria-labelledby="elenco-h">
    <div class="container">
      <div class="sec-head"><h2 id="elenco-h">Cosa può prenotare</h2><p>Prevenzione e Salute si avvale di professionisti qualificati.</p></div>
      <div class="sec-body">
        <PriceList items={serviceInfo} detailed>
          {serviceInfo.map((s) => (
            <a slot={s.id} class="arrow-link" href={`${bookHref}?servizio=${s.id}`}>
              {s.id === 'specialistica' ? 'Prenoti una visita specialistica' : 'Prenoti questo certificato'} <Icon name="arrow" size={18} />
            </a>
          ))}
        </PriceList>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="portare-h">
    <div class="container">
      <div class="sec-head"><h2 id="portare-h">Cosa portare alla visita</h2></div>
      <div class="sec-body">
        <ul class="rows">
          <li>Documento d'identità e tessera sanitaria</li>
          <li>Eventuali referti o esami recenti</li>
          <li>Per i minori: presenza di un genitore o tutore</li>
        </ul>
        <div class="actions"><a class="btn btn-primary btn-lg" href={bookHref} data-primary-cta>Prenota online <Icon name="arrow" size={20} /></a></div>
      </div>
    </div>
  </section>

  <section class="sec" id="domande" aria-labelledby="faq-h">
    <div class="container">
      <div class="sec-head"><h2 id="faq-h">Domande sul certificato e sulla visita</h2></div>
      <div class="sec-body">
        {faq.map(([q, a]) => <FaqItem q={q} a={a} />)}
      </div>
    </div>
  </section>
</Page>

<style>
  .sec-body :global(.plist .arrow-link) { margin-top: var(--space-1); justify-self: start; }
</style>
