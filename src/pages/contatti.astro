---
import Page from '../layouts/Page.astro';
import { site } from '../data/site.js';
import Icon from '../components/Icon.astro';
const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
---
<Page title="Contatti e orari | Prevenzione e Salute – Via Piacenza 4, Milano" description="Studio medico presso GetFIT, Via Piacenza 4, 20135 Milano, primo piano. Orari, telefono, WhatsApp, email e indicazioni per raggiungerci." heading="Contatti e orari">
  <section>
    <div class="container prose">
      <p><strong>Indirizzo:</strong> GetFIT, {site.address} — primo piano</p>
      <div class="actions"><a class="btn btn-primary" href={bookHref}>Prenota online</a><a class="btn" href={site.mapsUrl}><Icon name="pin" size={20} /> Indicazioni stradali</a></div>
      <h2>Orari di apertura</h2>
      <p>In arrivo.</p>
      <h2>Telefono, WhatsApp ed email</h2>
      <ul>
        <li>Telefono: {site.phone || '[numero]'}</li>
        <li>WhatsApp: {site.whatsapp || '[numero]'}</li>
        <li>Email: {site.email || '[email]'}</li>
      </ul>
    </div>
  </section>
</Page>
