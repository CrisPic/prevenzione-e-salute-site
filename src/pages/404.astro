---
import Page from '../layouts/Page.astro';
import { site } from '../data/site.js';
const bookHref = site.bookingUrl || '/prenota/';
---
<Page noindex title="Pagina non trovata | Prevenzione e Salute" description="La pagina cercata non esiste o è stata spostata." eyebrow="Errore 404" heading="Pagina non trovata" intro="La pagina che cerca non esiste o è stata spostata.">
  <section>
    <div class="container prose">
      <div class="actions">
        <a class="btn btn-primary" href={bookHref}>Prenota la visita</a>
        <a class="btn" href="/">Torna alla home</a>
        <a class="btn" href="/servizi/">Servizi e prezzi</a>
      </div>
    </div>
  </section>
</Page>
