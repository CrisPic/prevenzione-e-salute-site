---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
const path = Astro.url.pathname.replace(/\/?$/, '/');
const links = [
  { href: '/servizi/', label: 'Servizi' },
  { href: '/partner/', label: 'Per palestre e aziende' },
  { href: '/contatti/', label: 'Contatti' },
];
const current = (href) => (path === href ? 'page' : undefined);
---
<header class="header">
  <div class="container bar">
    <a class="logo" href="/"><img src="/favicon.svg" alt="" width="34" height="34" /><span>{site.name}</span></a>
    <nav class="nav" aria-label="Principale">
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      {site.showEnglish && <a href="/en/" class="lang" lang="en">EN</a>}
      <a class="btn btn-primary" href={bookHref}>Prenota</a>
    </nav>

    <!-- Mobile menu: native <details>, no JavaScript -->
    <details class="menu">
      <summary class="menu__toggle">
        <span class="visually-hidden">Menu</span>
        <Icon name="menu" size={24} class="menu__open" />
        <Icon name="close" size={24} class="menu__close" />
      </summary>
      <nav class="menu__panel" aria-label="Menu">
        {links.map((l) => (
          <a href={l.href} aria-current={current(l.href)}>{l.label}<Icon name="arrow" size={20} /></a>
        ))}
        {site.showEnglish && <a href="/en/" lang="en">English</a>}
        <a class="btn btn-primary menu__cta" href={bookHref}>Prenota la visita</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Progressive enhancement: the menu works without JS; this adds Esc, tap-outside and focus-out closing.
  const menu = document.querySelector('.menu');
  if (menu) {
    const summary = menu.querySelector('summary');
    const close = (refocus) => { if (menu.open) { menu.open = false; if (refocus) summary.focus(); } };
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(true); });
    document.addEventListener('click', (e) => { if (!menu.contains(e.target)) close(false); });
    menu.addEventListener('focusout', (e) => { if (e.relatedTarget && !menu.contains(e.relatedTarget)) close(false); });
  }
</script>

<style>
  .header { position: sticky; top: 0; z-index: 20; background: var(--header-bg); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .logo { display: flex; align-items: center; gap: 10px; min-height: 44px; font-weight: var(--fw-bold); color: var(--brand-dark); text-decoration: none; font-size: 17px; }
  .nav { display: flex; align-items: center; gap: var(--space-6); }
  .nav a:not(.btn) { color: var(--text); text-decoration: none; font-weight: var(--fw-medium); font-size: 15px; min-height: 44px; display: inline-flex; align-items: center; }
  .nav a:not(.btn):hover, .nav a[aria-current='page'] { color: var(--brand); }
  .nav a[aria-current='page'] { font-weight: 700; }
  .nav .btn { min-height: 44px; padding: 0 var(--space-5); font-weight: var(--fw-bold); }
  .lang { font-weight: 700 !important; color: var(--brand) !important; }

  .menu { display: none; }
  .menu__toggle { list-style: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--radius-s); background: var(--card); border: 1px solid var(--line); color: var(--brand-dark); cursor: pointer; }
  .menu__toggle::-webkit-details-marker { display: none; }
  .menu :global(.menu__close), .menu[open] :global(.menu__open) { display: none; }
  .menu[open] :global(.menu__close) { display: block; }
  .menu__panel { position: absolute; left: 0; right: 0; top: 68px; background: var(--bg); padding: var(--space-2) var(--space-5) var(--space-6); border-bottom: 1px solid var(--line); box-shadow: var(--shadow-float); }
  .menu__panel a:not(.btn) { display: flex; align-items: center; justify-content: space-between; min-height: 56px; border-bottom: 1px solid var(--line); color: var(--brand-dark); text-decoration: none; font-weight: var(--fw-semibold); font-size: var(--fs-md); }
  .menu__panel a:not(.btn) :global(.icon) { color: var(--brand); }
  .menu[open] .menu__panel { animation: menu-in var(--dur) var(--ease); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }
  .menu__panel a[aria-current='page'] { color: var(--brand); }
  .menu__cta { width: 100%; margin-top: var(--space-5); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  @media (max-width: 820px) {
    .nav { display: none; }
    .menu { display: block; }
  }
</style>
