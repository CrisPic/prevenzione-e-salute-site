---
import { site } from '../data/site.js';
const bookHref = site.bookingUrl || '/prenota/';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const links = [
  { href: '/servizi/', label: 'Servizi' },
  { href: '/partner/', label: 'Per palestre e aziende' },
  { href: '/contatti/', label: 'Contatti' },
];
const current = (href) => (path === href ? 'page' : undefined);
---
<header class="header">
  <div class="container bar">
    <a class="logo" href="/"><img src="/favicon.svg" alt="" width="34" height="34" /><span>{site.name}</span></a>
    <nav class="nav" aria-label="Principale">
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      {site.showEnglish && <a href="/en/" class="lang" lang="en">EN</a>}
      <a class="btn btn-primary" href={bookHref}>Prenota</a>
    </nav>

    <!-- Mobile menu: native <details>, no JavaScript -->
    <details class="menu">
      <summary class="menu__toggle">
        <span class="visually-hidden">Menu</span>
        <svg class="menu__open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
        <svg class="menu__close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </summary>
      <nav class="menu__panel" aria-label="Menu">
        {links.map((l) => (
          <a href={l.href} aria-current={current(l.href)}>{l.label}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg></a>
        ))}
        {site.showEnglish && <a href="/en/" lang="en">English</a>}
        <a class="btn btn-primary menu__cta" href={bookHref}>Prenota la visita</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Progressive enhancement: the menu works without JS; this adds Esc, tap-outside and focus-out closing.
  const menu = document.querySelector('.menu');
  if (menu) {
    const summary = menu.querySelector('summary');
    const close = (refocus) => { if (menu.open) { menu.open = false; if (refocus) summary.focus(); } };
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(true); });
    document.addEventListener('click', (e) => { if (!menu.contains(e.target)) close(false); });
    menu.addEventListener('focusout', (e) => { if (e.relatedTarget && !menu.contains(e.relatedTarget)) close(false); });
  }
</script>

<style>
  .header { position: sticky; top: 0; z-index: 20; background: rgba(246,249,249,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .logo { display: flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 750; color: var(--brand-dark); text-decoration: none; font-size: 17px; }
  .nav { display: flex; align-items: center; gap: 24px; }
  .nav a:not(.btn) { color: var(--text); text-decoration: none; font-weight: 550; font-size: 15px; min-height: 44px; display: inline-flex; align-items: center; }
  .nav a:not(.btn):hover, .nav a[aria-current='page'] { color: var(--brand); }
  .nav a[aria-current='page'] { font-weight: 700; }
  .nav .btn { min-height: 44px; padding: 0 18px; }
  .lang { font-weight: 700 !important; color: var(--brand) !important; }

  .menu { display: none; }
  .menu__toggle { list-style: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--radius-s); background: #fff; border: 1px solid var(--line); color: var(--brand-dark); cursor: pointer; }
  .menu__toggle::-webkit-details-marker { display: none; }
  .menu__close, .menu[open] .menu__open { display: none; }
  .menu[open] .menu__close { display: block; }
  .menu__panel { position: absolute; left: 0; right: 0; top: 68px; background: var(--bg); padding: 8px 20px 24px; border-bottom: 1px solid var(--line); box-shadow: 0 24px 40px -20px rgba(10,63,68,.35); }
  .menu__panel a:not(.btn) { display: flex; align-items: center; justify-content: space-between; min-height: 56px; border-bottom: 1px solid var(--line); color: var(--brand-dark); text-decoration: none; font-weight: 650; font-size: 18px; }
  .menu__panel a:not(.btn) svg { color: var(--brand); }
  .menu__panel a[aria-current='page'] { color: var(--brand); }
  .menu__cta { width: 100%; margin-top: 20px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  @media (max-width: 820px) {
    .nav { display: none; }
    .menu { display: block; }
  }
</style>
