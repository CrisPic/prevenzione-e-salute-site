---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
const path = Astro.url.pathname.replace(/\/?$/, '/');
const onBooking = path.startsWith('/prenota');
const links = [
  { href: '/servizi/', label: 'Servizi e prezzi' },
  { href: '/partner/', label: 'Palestre e aziende' },
  { href: '/contatti/', label: 'Contatti' },
];
const current = (href) => (path === href ? 'page' : undefined);
---
<header class="header">
  <div class="container bar">
    <a class="logo" href="/" aria-current={path === '/' ? 'page' : undefined}><img src="/favicon.svg" alt="" width="28" height="28" /><span>{site.name}</span></a>
    <nav class="nav" aria-label="Principale">
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      {site.showEnglish && <a href="/en/" lang="en">EN</a>}
    </nav>
    <div class="tools">
      <!-- On Prenota the form is the action: no second Prenota competing with it -->
      {!onBooking && <a class="btn btn-primary book" href={bookHref}>Prenota</a>}
      <!-- Mobile menu: native <details>, no JavaScript needed -->
      <details class="menu">
        <summary class="menu__toggle">
          <span>Menu</span>
          <Icon name="menu" size={18} class="menu__open" />
          <Icon name="close" size={18} class="menu__close" />
        </summary>
        <nav class="menu__panel" aria-label="Menu">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
          <a href={bookHref} aria-current={current(bookHref)}>Prenota online</a>
          {site.showEnglish && <a href="/en/" lang="en">English</a>}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement: the menu works without JS; this adds Esc, tap-outside and focus-out closing.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  if (menu) {
    const summary = menu.querySelector('summary')!;
    const close = (refocus: boolean) => { if (menu.open) { menu.open = false; if (refocus) summary.focus(); } };
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(true); });
    document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) close(false); });
    menu.addEventListener('focusout', (e) => { const t = e.relatedTarget as Node | null; if (t && !menu.contains(t)) close(false); });
  }
</script>

<style>
  .header { position: sticky; top: 0; z-index: 20; background: var(--bg); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: var(--space-6); height: var(--header-h); }
  .logo { display: flex; align-items: center; gap: 10px; min-height: 44px; font-weight: var(--fw-bold); color: var(--brand-dark); text-decoration: none; font-size: 16px; letter-spacing: -0.01em; margin-right: auto; }
  .nav { display: flex; align-items: center; gap: var(--space-6); }
  .nav a { color: var(--text); text-decoration: none; font-weight: var(--fw-medium); font-size: var(--fs-sm); min-height: 44px; display: inline-flex; align-items: center; border-bottom: 2px solid transparent; padding-top: 2px; }
  .nav a:hover { color: var(--brand); }
  .nav a[aria-current='page'] { color: var(--brand-dark); border-bottom-color: var(--brand); font-weight: var(--fw-semibold); }
  .tools { display: flex; align-items: center; gap: var(--space-2); }
  .book { min-height: 44px; padding: 0 var(--space-4); font-size: var(--fs-sm); }

  .menu { display: none; }
  .menu__toggle { list-style: none; min-height: 44px; padding: 0 var(--space-3); display: flex; align-items: center; gap: 6px; border-radius: var(--radius-m); border: 2px solid var(--line-control); color: var(--brand-dark); font-weight: var(--fw-semibold); font-size: var(--fs-sm); cursor: pointer; }
  .menu__toggle::-webkit-details-marker { display: none; }
  .menu :global(.menu__close), .menu[open] :global(.menu__open) { display: none; }
  .menu[open] :global(.menu__close) { display: block; }
  .menu__panel { position: absolute; left: 0; right: 0; top: var(--header-h); background: var(--bg); padding: 0 var(--gutter) var(--space-4); border-bottom: 2px solid var(--rule); }
  .menu__panel a { display: flex; align-items: center; min-height: 52px; border-bottom: 1px solid var(--line); color: var(--brand-dark); text-decoration: none; font-weight: var(--fw-semibold); font-size: var(--fs-md); }
  .menu__panel a[aria-current='page'] { color: var(--brand); box-shadow: inset 3px 0 0 var(--brand); padding-left: var(--space-3); }

  /* Phones: Prenota lives in the bottom bar (and in the menu), so the header keeps just name + Menu */
  @media (max-width: 820px) {
    .nav, .book { display: none; }
    .menu { display: block; }
  }
</style>
