---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
const path = Astro.url.pathname.replace(/\/?$/, '/');
const onBooking = path.startsWith('/prenota');
const links = [
  { href: '/servizi/', label: 'Servizi e prezzi' },
  { href: '/partner/', label: 'Palestre e aziende' },
  { href: '/contatti/', label: 'Contatti' },
];
const current = (href) => (path === href ? 'page' : undefined);
---
<header class="header">
  <div class="container bar">
    <a class="logo" href="/" aria-current={path === '/' ? 'page' : undefined}><img src="/favicon.svg" alt="" width="28" height="28" /><span>{site.name}</span></a>
    <nav class="nav" aria-label="Principale">
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      {site.showEnglish && <a href="/en/" lang="en">EN</a>}
    </nav>
    <div class="tools">
      <!-- On Prenota the form is the action: no second Prenota competing with it -->
      {!onBooking && <a class="btn btn-primary book" href={bookHref}>Prenota</a>}
      <!-- Mobile menu: native popover. The browser handles open/close, aria-expanded, Esc and tap-outside; no JavaScript -->
      <button type="button" class="menu__toggle" popovertarget="site-menu">
        <span>Menu</span>
        <Icon name="menu" size={18} class="menu__open" />
        <Icon name="close" size={18} class="menu__close" />
      </button>
    </div>
  </div>
  <nav id="site-menu" class="menu__panel" popover aria-label="Menu">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
    {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
    <a href={bookHref} aria-current={current(bookHref)}>Prenota online</a>
    {site.showEnglish && <a href="/en/" lang="en">English</a>}
  </nav>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 20; background: var(--bg); border-bottom: 1px solid var(--line); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--space-6); min-height: var(--header-h); }
  .logo { display: flex; align-items: center; gap: 10px; min-height: 44px; font-weight: var(--fw-bold); color: var(--brand-dark); text-decoration: none; font-size: 1rem; letter-spacing: -0.01em; margin-right: auto; }
  .nav { display: flex; align-items: center; gap: var(--space-6); }
  .nav a { color: var(--text); text-decoration: none; font-weight: var(--fw-medium); font-size: var(--fs-sm); min-height: 44px; display: inline-flex; align-items: center; border-bottom: 2px solid transparent; padding-top: 2px; }
  .nav a:hover { color: var(--brand); }
  .nav a[aria-current='page'] { color: var(--brand-dark); border-bottom-color: var(--brand); font-weight: var(--fw-semibold); }
  .tools { display: flex; align-items: center; gap: var(--space-2); }
  .book { min-height: 44px; padding: 0 var(--space-4); font-size: var(--fs-sm); }

  .menu__toggle { display: none; min-height: 44px; font: inherit; background: transparent; padding: 0 var(--space-3); align-items: center; gap: 6px; border-radius: var(--radius-m); border: 2px solid var(--line-control); color: var(--brand-dark); font-weight: var(--fw-semibold); font-size: var(--fs-sm); cursor: pointer; }
  .menu__toggle :global(.menu__close), .header:has(.menu__panel:popover-open) .menu__toggle :global(.menu__open) { display: none; }
  .header:has(.menu__panel:popover-open) .menu__toggle :global(.menu__close) { display: block; }
  /* Top layer, pinned just under the sticky header; scrolls on its own if taller than the screen */
  .menu__panel { inset: var(--header-h) 0 auto 0; width: auto; max-height: calc(100dvh - var(--header-h)); overflow: auto; margin: 0; border: 0; color: inherit; background: var(--bg); padding: 0 var(--gutter) var(--space-4); border-bottom: 2px solid var(--rule); }
  .menu__panel a { display: flex; align-items: center; min-height: 52px; border-bottom: 1px solid var(--line); color: var(--brand-dark); text-decoration: none; font-weight: var(--fw-semibold); font-size: var(--fs-md); }
  .menu__panel a[aria-current='page'] { color: var(--brand); box-shadow: inset 3px 0 0 var(--brand); padding-left: var(--space-3); }

  /* Phones: Prenota lives in the bottom bar (and in the menu), so the header keeps just name + Menu */
  @media (width <= 51.25em) {
    .nav, .book { display: none; }
    .menu__toggle { display: flex; }
  }
  /* The menu belongs to the phone layout: never left open after widening the window */
  @media (width > 51.25em) { .menu__panel { display: none; } }
  /* Browsers without popover (before 2024): no toggle, the links simply sit under the bar */
  @supports not selector(:popover-open) {
    .header { position: static; }
    .menu__panel { display: block; position: static; padding-top: 0; border-bottom: 0; }
    @media (width <= 51.25em) { .menu__toggle { display: none; } }
  }
</style>
