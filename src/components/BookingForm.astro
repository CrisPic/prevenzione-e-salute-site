---
// Native booking form: service -> day -> time -> contact details -> confirm.
// Talks only to our own Worker (/api/booking*). Without JS, or when booking is off,
// the fallback callout (WhatsApp / phone) stays visible and the form stays hidden.
import { booking } from '../data/site.js';
import InfoCallout from './InfoCallout.astro';
import Icon from './Icon.astro';
import { site } from '../data/site.js';
const tz = booking.timeZone;
const bookable = booking.services.filter((s) => s.eventTypeId); // services without a calendar event are not offered
// Name only the channels that really exist; with none configured the messages just ask to retry
const channels = [site.whatsapp && 'su WhatsApp', site.phone && 'per telefono'].filter(Boolean).join(' o ');
const fallback = channels ? ` In alternativa ci contatti ${channels}.` : '';
---
<div class="bk" data-bk data-tz={tz} data-fallback={fallback}>
  <div data-bk-fallback>
    <InfoCallout icon="calendar"><p>Il calendario di prenotazione online non è disponibile in questo momento. {channels ? `Può prenotare ${channels}.` : 'Riprovi più tardi.'}</p></InfoCallout>
  </div>

  <!-- Shown while JS loads the calendar (only when JS runs; without JS the fallback above stays) -->
  <div class="bk-boot" role="status">
    <span class="bk-sr">Caricamento del calendario di prenotazione…</span>
    <div aria-hidden="true">
      <span class="bk-skel bk-skel--title"></span>
      <span class="bk-skel bk-skel--row"></span>
      <span class="bk-skel bk-skel--row"></span>
      <span class="bk-skel bk-skel--row"></span>
      <span class="bk-skel bk-skel--title"></span>
      <div class="bk-boot__days">{Array.from({ length: 7 }, () => <span class="bk-skel bk-skel--day"></span>)}</div>
    </div>
  </div>
  <!-- Safety net: if the booking script never loads or the calendar never answers, show the fallback after 10 s -->
  <script is:inline>setTimeout(function () { var r = document.querySelector('[data-bk]'); if (r && !r.dataset.state) r.dataset.state = 'fallback'; }, 10000);</script>

  <form class="bk-form" data-bk-form novalidate hidden>
    <p class="bk-sr" data-bk-status role="status" aria-live="polite"></p>
    <p class="bk-demo" data-bk-demo hidden><strong>Versione dimostrativa.</strong> Gli orari sono di esempio e nessuna prenotazione viene registrata.</p>

    <fieldset class="bk-step">
      <legend><span class="bk-num">1</span> Servizio</legend>
      <div class="bk-services">
        {bookable.map((s, i) => (
          <label class="bk-service">
            <input type="radio" name="service" value={s.id} data-label={s.label} checked={i === 0} />
            <span class="bk-service__name">{s.label}</span>
            <span class="bk-service__meta">{s.price}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="bk-step">
      <legend><span class="bk-num">2</span> Giorno</legend>
      <div class="bk-days" data-bk-days></div>
    </fieldset>

    <fieldset class="bk-step">
      <legend><span class="bk-num">3</span> Orario</legend>
      <div data-bk-times><p class="bk-muted">Scelga prima un giorno.</p></div>
    </fieldset>

    <fieldset class="bk-step">
      <legend><span class="bk-num">4</span> I suoi dati</legend>
      <div class="bk-fields">
        <label class="bk-field">
          <span>Nome e cognome</span>
          <input name="name" autocomplete="name" required minlength="3" maxlength="80" />
          <small class="bk-err" id="bk-err-name" data-err="name">Inserisca nome e cognome.</small>
        </label>
        <label class="bk-field">
          <span>Telefono</span>
          <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="es. 333 123 4567" />
          <small class="bk-err" id="bk-err-phone" data-err="phone">Inserisca un numero di telefono valido.</small>
        </label>
        <label class="bk-field">
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required maxlength="120" />
          <small class="bk-err" id="bk-err-email" data-err="email">Inserisca un indirizzo email valido.</small>
        </label>
        <!-- Honeypot: hidden from people, bots fill it in -->
        <label class="bk-hp" aria-hidden="true">Sito web <input name="website" tabindex="-1" autocomplete="off" /></label>
        <label class="bk-check">
          <input type="checkbox" name="privacy" required />
          <span>Ho letto l'<a href="/privacy/#prenotazioni" target="_blank">informativa privacy</a>.</span>
        </label>
        <small class="bk-err" id="bk-err-privacy" data-err="privacy">È necessario confermare di aver letto l'informativa.</small>
      </div>
      <p class="bk-note">Non inserisca informazioni sulla sua salute: le chiederà il medico durante la visita.</p>
    </fieldset>

    <div class="bk-summary" data-bk-summary hidden></div>
    <p class="bk-alert" data-bk-alert role="alert" hidden></p>
    <button type="submit" class="btn btn-primary btn-lg bk-submit" data-bk-submit><span class="bk-spinner" aria-hidden="true"></span><span data-bk-submit-label>Conferma la prenotazione</span></button>
  </form>

  <div class="bk-done" data-bk-done hidden tabindex="-1">
    <p class="bk-done__tag"><span class="bk-done__check"><Icon name="check" size={20} /></span>Prenotazione confermata</p>
    <h2 class="bk-done__title" data-bk-done-when></h2>
    <p data-bk-done-what></p>
    <p data-bk-done-mail>Le abbiamo inviato un'email di conferma con il link per disdire o spostare l'appuntamento.</p>
    <p class="bk-muted">Studio medico c/o GetFIT, Via Piacenza 4, primo piano, Milano. Porti un documento d'identità e la tessera sanitaria.</p>
  </div>
</div>

<script>
  type Slot = { time: string; start: string };
  type Day = { date: string; slots: Slot[] };

  const root = document.querySelector<HTMLElement>('[data-bk]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const tz = root.dataset.tz!;
    const fallback = root.dataset.fallback || '';
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const form = $<HTMLFormElement>('[data-bk-form]');
    const daysBox = $('[data-bk-days]');
    const timesBox = $('[data-bk-times]');
    const summary = $('[data-bk-summary]');
    const alertBox = $('[data-bk-alert]');
    const submit = $<HTMLButtonElement>('[data-bk-submit]');
    const status = $('[data-bk-status]');
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('.bk-step')];

    const fmtDay = new Intl.DateTimeFormat('it-IT', { timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short' });
    const fmtLong = new Intl.DateTimeFormat('it-IT', { timeZone: tz, weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
    const noon = (d: string) => new Date(`${d}T12:00:00Z`);

    let days: Day[] = [];
    let chosenDate = '';
    let chosenSlot: Slot | null = null;
    let slotsReq = 0;        // only the latest slots request may render
    let pending = false;     // a booking request is in flight
    let submitId = 0;        // only the latest submit may change the lock or the page

    // Screen-reader announcement (visually hidden live region)
    const announce = (msg: string) => { status.textContent = ''; requestAnimationFrame(() => { status.textContent = msg; }); };

    const service = () => form.querySelector<HTMLInputElement>('input[name=service]:checked')!;

    // Returns true only if this call's result was rendered (not superseded)
    async function loadSlots(): Promise<boolean> {
      const req = ++slotsReq;
      chosenDate = '';
      chosenSlot = null;
      daysBox.innerHTML = '<span class="bk-skel bk-skel--day"></span>'.repeat(7); // loading state: placeholder day tiles
      daysBox.setAttribute('aria-busy', 'true');
      timesBox.innerHTML = '<p class="bk-muted">Scelga prima un giorno.</p>';
      updateSummary();
      if (!form.hidden) announce('Caricamento degli orari disponibili.');
      // Bounded loading state: abort after 8 s (request + parsing) and show the error / fallback.
      // AbortController + timer instead of AbortSignal.timeout(), which older browsers lack.
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 8000);
      try {
        const res = await fetch(`/api/booking/slots?service=${encodeURIComponent(service().value)}`, { signal: ctrl.signal });
        const data = await res.json();
        clearTimeout(timer);
        if (req !== slotsReq) return false; // the patient picked another service meanwhile
        if (!data.ok) throw new Error(data.error);
        root.querySelector('[data-bk-fallback]')!.setAttribute('hidden', '');
        form.hidden = false;
        root.dataset.state = 'ready';
        daysBox.removeAttribute('aria-busy');
        $('[data-bk-demo]').hidden = !data.demo;
        root.dataset.demo = data.demo ? '1' : '';
        days = data.days;
        renderDays();
        return true;
      } catch {
        clearTimeout(timer);
        if (req !== slotsReq) return false;
        daysBox.removeAttribute('aria-busy');
        if (form.hidden) { root.dataset.state = 'fallback'; return false; } // show the fallback callout (also after the 10 s safety net)
        const msg = `Non riusciamo a caricare gli orari. Ricarichi la pagina tra qualche minuto.${fallback}`;
        daysBox.innerHTML = `<p class="bk-muted">${msg}</p>`;
        announce(msg);
        return true;
      }
    }

    function renderDays() {
      const open = days.filter((d) => d.slots.length);
      if (!open.length) {
        const msg = `Nessun orario libero nei prossimi giorni. Riprovi più avanti.${fallback}`;
        daysBox.innerHTML = `<p class="bk-muted">${msg}</p>`;
        announce(msg);
        return;
      }
      announce(open.length === 1 ? 'Orari disponibili in 1 giorno. Scelga il giorno.' : `Orari disponibili in ${open.length} giorni. Scelga il giorno.`);
      daysBox.innerHTML = '';
      for (const d of days) {
        const [wd, num, mon] = fmtDay.format(noon(d.date)).replace(',', '').split(' ');
        const label = document.createElement('label');
        label.className = 'bk-day';
        label.innerHTML = `<input type="radio" name="day" value="${d.date}" ${d.slots.length ? '' : 'disabled'}>
          <span class="bk-day__wd">${wd}</span><span class="bk-day__num">${num}</span><span class="bk-day__mon">${mon}</span>`;
        label.title = d.slots.length ? `${d.slots.length} orari liberi` : 'Nessun orario libero';
        daysBox.append(label);
      }
    }

    function renderTimes() {
      const day = days.find((d) => d.date === chosenDate);
      if (!day) return;
      const groups: [string, Slot[]][] = [
        ['Mattina', day.slots.filter((s) => s.time < '13:00')],
        ['Pomeriggio', day.slots.filter((s) => s.time >= '13:00')],
      ];
      timesBox.innerHTML = '';
      for (const [name, slots] of groups) {
        if (!slots.length) continue;
        const g = document.createElement('div');
        g.className = 'bk-timegroup';
        g.innerHTML = `<p class="bk-timegroup__name">${name}</p><div class="bk-times"></div>`;
        const grid = g.querySelector('.bk-times')!;
        for (const s of slots) {
          const l = document.createElement('label');
          l.className = 'bk-time';
          l.innerHTML = `<input type="radio" name="time" value="${s.start}"><span>${s.time}</span>`;
          grid.append(l);
        }
        timesBox.append(g);
      }
    }

    function updateSummary() {
      if (!chosenSlot) { summary.hidden = true; return; }
      summary.hidden = false;
      summary.innerHTML = `<span class="bk-muted">Riepilogo</span><strong>${service().dataset.label}</strong><span>${capitalize(fmtLong.format(new Date(chosenSlot.start)))}</span>`;
    }

    const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

    function showError(field: string, on: boolean) {
      const err = root.querySelector<HTMLElement>(`[data-err="${field}"]`);
      const input = form.elements.namedItem(field) as HTMLInputElement | null;
      if (err) err.classList.toggle('is-on', on);
      if (input) {
        input.setAttribute('aria-invalid', on ? 'true' : 'false');
        if (on && err) input.setAttribute('aria-describedby', err.id); else input.removeAttribute('aria-describedby');
      }
      return { err, input };
    }

    function validate() {
      const f = form.elements as any;
      const checks: [string, boolean][] = [
        ['name', f.name.value.trim().length >= 3],
        ['phone', /^\+?[\d\s.\-()/]{8,20}$/.test(f.phone.value.trim())],
        ['email', /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(f.email.value.trim())],
        ['privacy', f.privacy.checked],
      ];
      let firstBad: string | null = null;
      for (const [k, ok] of checks) { showError(k, !ok); if (!ok && !firstBad) firstBad = k; }
      if (!chosenSlot) { alert('Scelga un giorno e un orario.'); daysBox.scrollIntoView({ block: 'center' }); return false; }
      if (firstBad) { (f[firstBad] as HTMLElement).focus(); return false; }
      return true;
    }

    function alert(msg: string) { alertBox.textContent = msg; alertBox.hidden = !msg; }

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (pending) return;
      if (t.name === 'service') loadSlots();
      if (t.name === 'day') {
        chosenDate = t.value; chosenSlot = null; renderTimes(); updateSummary(); alert('');
        const n = days.find((d) => d.date === chosenDate)?.slots.length || 0;
        announce(n === 1 ? '1 orario disponibile. Scelga l\'orario.' : `${n} orari disponibili. Scelga l'orario.`);
      }
      if (t.name === 'time') { chosenSlot = days.find((d) => d.date === chosenDate)!.slots.find((s) => s.start === t.value) || null; updateSummary(); alert(''); }
      if (['name', 'phone', 'email', 'privacy'].includes(t.name)) showError(t.name, false);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (pending) return;
      alert('');
      if (!validate()) return;
      const id = ++submitId;
      const current = () => id === submitId;
      const f = form.elements as any;
      // Freeze what is being booked: the confirmation must show exactly this,
      // whatever happens to the form while the request is in flight.
      const sent = { serviceId: service().value, serviceLabel: service().dataset.label!, start: chosenSlot!.start };
      setPending(true);
      let booked = false;
      try {
        const res = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            service: sent.serviceId, start: sent.start,
            name: f.name.value, phone: f.phone.value, email: f.email.value,
            privacy: f.privacy.checked, website: f.website.value,
          }),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!current()) return;
        if (data.ok) { booked = true; return done(sent, !!data.demo); }
        setPending(false);
        if (data.error === 'slot_taken' || data.error === 'slot_unavailable') {
          alert(data.error === 'slot_taken'
            ? 'Questo orario è appena stato prenotato da un\'altra persona. Ne scelga un altro tra quelli aggiornati.'
            : 'L\'orario scelto non è più disponibile. Ne scelga un altro tra quelli aggiornati.');
          const rendered = await loadSlots();
          // Scroll only if nothing newer (another service, another submit) took over meanwhile
          if (rendered && current() && !pending) daysBox.scrollIntoView({ block: 'center' });
        } else if (data.error === 'rate_limited') {
          alert('Troppi tentativi in poco tempo. Attenda un minuto e riprovi.');
        } else if (data.field && ['name', 'phone', 'email', 'privacy'].includes(data.field)) {
          const { err, input } = showError(data.field, true);
          alert(err?.textContent || 'Controlli i dati inseriti.');
          input?.focus();
        } else {
          alert(`Non siamo riusciti a completare la prenotazione. Riprovi tra poco.${fallback}`);
        }
      } catch {
        if (!booked && current()) alert('Connessione non riuscita. Controlli la rete e riprovi.');
      } finally {
        // An older submit must never unlock a newer pending one
        if (!booked && current()) setPending(false);
      }
    });

    function setPending(on: boolean) {
      pending = on;
      for (const fs of steps) fs.disabled = on; // service, day, time and details are locked while sending
      submit.disabled = on;
      submit.classList.toggle('is-pending', on);
      $('[data-bk-submit-label]').textContent = on ? 'Invio in corso…' : 'Conferma la prenotazione';
      form.setAttribute('aria-busy', on ? 'true' : 'false');
    }

    function done(sent: { serviceLabel: string; start: string }, demo: boolean) {
      const box = $('[data-bk-done]');
      $('[data-bk-done-when]').textContent = capitalize(fmtLong.format(new Date(sent.start)));
      $('[data-bk-done-what]').textContent = sent.serviceLabel;
      if (demo) $('[data-bk-done-mail]').textContent = 'Versione dimostrativa: nessuna prenotazione è stata registrata e nessuna email è stata inviata.';
      form.hidden = true;
      box.hidden = false;
      box.focus();
      box.scrollIntoView({ block: 'start' });
    }

    // Links like /prenota/?servizio=certificato preselect that service; the patient can still switch
    const wanted = new URLSearchParams(location.search).get('servizio');
    const pre = wanted && form.querySelector<HTMLInputElement>(`input[name=service][value="${CSS.escape(wanted)}"]`);
    if (pre) pre.checked = true;

    loadSlots();
  }
</script>

<style>
  .bk { margin: 0 0 var(--space-6); }
  /* Form holds radius-s tiles at its padding edge: radius = radius-s + padding */
  .bk-form, .bk-boot { --pad: var(--space-6); background: var(--card); border: 1px solid var(--line); border-radius: calc(var(--radius-s) + var(--pad)); padding: var(--space-2) var(--pad) var(--pad); }
  .bk-demo { margin: var(--space-4) 0 0; padding: 10px 14px; background: var(--notice-soft); border-radius: var(--radius-s); font-size: 15px; }
  .bk-step { border: 0; margin: 0; padding: var(--space-5) 0 var(--space-1); min-width: 0; }
  .bk-step + .bk-step { border-top: 1px solid var(--line); }
  .bk-step legend { display: flex; align-items: center; gap: 10px; float: left; width: 100%; margin-bottom: 14px; font-weight: 700; font-size: var(--fs-md); color: var(--brand-dark); }
  .bk-step legend + * { clear: both; }
  .bk-num { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--brand-soft); color: var(--brand); font-size: var(--fs-sm); }
  .bk-muted { color: var(--muted); margin: 0; }
  .bk :global(input[type=radio]) { position: absolute; opacity: 0; width: 1px; height: 1px; }

  /* Loading states: boot skeleton replaces the "not available" flash; day tiles shimmer while slots load */
  .bk-boot { display: none; padding-top: var(--space-6); }
  :global(.js) .bk:not([data-state]) .bk-boot { display: block; }
  :global(.js) .bk:not([data-state='fallback']) [data-bk-fallback] { display: none; }
  .bk-boot__days { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--space-2); }
  .bk :global(.bk-skel) { display: block; border-radius: var(--radius-s); background: linear-gradient(90deg, var(--brand-soft) 0%, var(--skeleton-hi) 50%, var(--brand-soft) 100%) 0 0 / 200% 100%; animation: bk-shimmer 1.2s linear infinite; }
  .bk-skel--title { width: 140px; height: 24px; margin-bottom: 14px; }
  .bk-skel--row { height: 56px; margin-bottom: 10px; }
  .bk-skel--row + .bk-skel--title { margin-top: var(--space-6); }
  .bk :global(.bk-skel--day) { min-height: 76px; }
  @keyframes bk-shimmer { to { background-position: -200% 0; } }

  /* Selectable tiles (service, day, time) share one look */
  .bk-service, .bk :global(.bk-day), .bk :global(.bk-time) { position: relative; cursor: pointer; border: 2px solid var(--line-control); border-radius: var(--radius-s); background: var(--card); transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease); }
  .bk-service:hover, .bk :global(.bk-day:hover), .bk :global(.bk-time:hover) { border-color: var(--brand); }
  .bk-service:active, .bk :global(.bk-day:active), .bk :global(.bk-time:active) { transform: scale(.97); }
  .bk-service:has(input:checked), .bk :global(.bk-day:has(input:checked)), .bk :global(.bk-time:has(input:checked)) { border-color: var(--brand); background: var(--brand-soft); }
  .bk-service:has(input:focus-visible), .bk :global(.bk-day:has(input:focus-visible)), .bk :global(.bk-time:has(input:focus-visible)) { outline: 3px solid var(--focus); outline-offset: 2px; }

  .bk-services { display: grid; gap: 10px; }
  .bk-service { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); min-height: 56px; padding: var(--space-3) var(--space-4); }
  .bk-service__name { font-weight: 600; }
  .bk-service__meta { flex: 0 0 auto; font-size: 15px; color: var(--muted); }
  .bk-service:has(input:checked) .bk-service__meta { color: var(--brand-dark); font-weight: 600; }

  .bk-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--space-2); }
  .bk :global(.bk-day) { display: flex; flex-direction: column; align-items: center; padding: var(--space-2) var(--space-1); min-height: 76px; line-height: 1.2; animation: bk-in var(--dur) var(--ease) backwards; }
  .bk :global(.bk-day__wd), .bk :global(.bk-day__mon) { font-size: var(--fs-xs); color: var(--muted); text-transform: capitalize; }
  .bk :global(.bk-day__num) { font-size: 20px; font-weight: 700; color: var(--brand-dark); margin: 2px 0; }
  .bk :global(.bk-day:has(input:disabled)) { cursor: default; opacity: .4; background: transparent; border-color: var(--line); border-style: dashed; }
  .bk :global(.bk-day:has(input:disabled):hover) { border-color: var(--line); }
  .bk :global(.bk-day:has(input:disabled):active) { transform: none; }

  .bk :global(.bk-timegroup) { animation: bk-in var(--dur) var(--ease) backwards; }
  .bk :global(.bk-timegroup__name) { margin: 0 0 var(--space-2); font-size: var(--fs-sm); font-weight: 600; color: var(--muted); }
  .bk :global(.bk-timegroup + .bk-timegroup) { margin-top: 14px; }
  .bk :global(.bk-times) { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: var(--space-2); }
  .bk :global(.bk-time) { display: grid; place-items: center; min-height: 48px; font-weight: 600; font-variant-numeric: tabular-nums; }

  .bk-fields { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
  .bk-field { display: grid; gap: 6px; font-weight: 600; font-size: 15px; }
  .bk-field:first-child { grid-column: 1 / -1; }
  .bk-field input { font: inherit; font-weight: 400; min-height: 48px; padding: 10px 14px; border: 2px solid var(--line-control); border-radius: var(--radius-s); background: var(--card); color: var(--text); transition: border-color var(--dur-fast) var(--ease); }
  .bk-field input:focus { border-color: var(--brand); }
  .bk-field input[aria-invalid=true] { border-color: var(--danger); }
  .bk-check { grid-column: 1 / -1; display: flex; gap: 10px; align-items: flex-start; font-size: 15px; cursor: pointer; min-height: 44px; }
  .bk-check input { width: 22px; height: 22px; margin: 1px 0 0; accent-color: var(--brand); flex: 0 0 auto; }
  .bk-err { display: none; color: var(--danger); font-weight: 500; font-size: var(--fs-sm); }
