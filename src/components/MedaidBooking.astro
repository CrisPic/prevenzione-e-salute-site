---
interface Props {
  url: string;
}

const { url } = Astro.props;
const embedUrl = new URL(url);
embedUrl.searchParams.set('embed', '1');
---

<div data-medaid-booking>
  <p>Il calendario è fornito da Medaid. I dati che inserisce sono trattati dal medico titolare dello studio, con il supporto tecnico di Prevenzione e Salute S.r.l.s. e di Medaid. Prima di prenotare legga l'<a href="/privacy/#prenotazioni">informativa privacy</a>.</p>
  <a class="btn btn-primary" href={url} data-medaid-link>Apri il calendario</a>
  <iframe
    id="medaid-book-prevenzione-e-salute"
    title="Prenota online con Medaid – Prevenzione e Salute"
    loading="lazy"
    hidden
    data-src={embedUrl.href}
  ></iframe>
</div>

<script>
  const booking = document.querySelector('[data-medaid-booking]');
  const link = booking?.querySelector<HTMLAnchorElement>('[data-medaid-link]');
  const frame = booking?.querySelector<HTMLIFrameElement>('iframe');
  const source = frame?.dataset.src;

  if (link && frame && source) {
    const { origin } = new URL(source);

    window.addEventListener('message', (event) => {
      if (event.origin !== origin || event.source !== frame.contentWindow || !event.data) return;

      if (event.data.type === 'medaid-book:height') {
        const height = Number(event.data.height);
        if (Number.isInteger(height) && height > 0 && height <= 20000) frame.style.height = `${height}px`;
      }

      if (event.data.type === 'medaid-book:step' && frame.getBoundingClientRect().top < 0) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        frame.scrollIntoView({ behavior: reduceMotion ? 'instant' : 'smooth' });
      }
    });

    link.addEventListener('click', (event) => {
      if (!frame.hidden || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      frame.src = source;
      frame.hidden = false;
      link.textContent = 'Apri il calendario su Medaid';
      frame.focus();
    });
  }
</script>

<style>
  p { margin: 0 0 var(--space-3); }
  iframe {
    width: 100%;
    height: 720px;
    border: 0;
    margin-top: var(--space-4);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  iframe:not([hidden]) { display: block; }
</style>
