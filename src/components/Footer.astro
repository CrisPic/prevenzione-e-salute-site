---
import { site } from '../data/site.js';
---
<footer class="footer">
  <div class="container grid">
    <div>
      <p class="name">{site.name} – Studio medico</p>
      <p>{site.venue}<br />{site.address}</p>
    </div>
    <div>
      <p>Tel. {site.phone || '[numero]'} · WhatsApp {site.whatsapp || '[numero]'}<br />{site.email || '[email]'}</p>
      <p>P.IVA {site.vat} · PEC {site.pec}</p>
    </div>
    <div class="links">
      <a href="/privacy/">Privacy policy</a>
      <a href="/privacy/#cookie">Cookie policy</a>
      {site.showEnglish && <a href="/en/">English</a>}
    </div>
  </div>
</footer>

<style>
  .footer { --focus: var(--accent); background: var(--brand-dark); color: var(--on-dark-soft); padding: var(--space-10) 0 calc(var(--space-10) + var(--mbar-space)); font-size: var(--fs-sm); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-6); }
  .name { color: var(--on-dark); font-weight: 700; }
  p { margin: 0 0 var(--space-2); }
  .links { display: flex; flex-direction: column; }
  .links a { min-height: 44px; display: inline-flex; align-items: center; }
  a { color: var(--on-dark); }
</style>
