---
import { site, contactChannels } from '../data/site.js';
// Contact channels appear only once they exist in site.js.
// Company details (art. 2250 c.c.) are always shown.
const contacts = contactChannels();
---
<footer class="footer">
  <div class="container grid">
    <div>
      <p class="name">{site.name}</p>
      <p>Studio medico {site.venue}<br />{site.address}</p>
    </div>
    <div>
      {contacts.map((c) => <p>{c.label}: <a href={c.href}>{c.value}</a></p>)}
      <p>{site.legalName}<br />Sede legale {site.registeredOffice}</p>
      <p>P.IVA e C.F. {site.vat}<br />REA {site.rea}<br />Capitale sociale {site.shareCapital}<br />PEC <a href={`mailto:${site.pec}`}>{site.pec}</a></p>
    </div>
    <nav class="links" aria-label="Informazioni legali">
      <a href="/privacy/">Privacy</a>
      <a href="/privacy/#cookie">Cookie</a>
      {site.showEnglish && <a href="/en/" lang="en">English</a>}
    </nav>
  </div>
</footer>

<style>
  .footer { --focus: var(--on-dark); background: var(--brand-dark); color: var(--on-dark-soft); padding: var(--space-10) 0 calc(var(--space-10) + var(--mbar-space)); font-size: var(--fs-sm); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-6); }
  .name { color: var(--on-dark); font-weight: var(--fw-bold); font-size: var(--fs-body); }
  p { margin: 0 0 var(--space-2); }
  .links { display: flex; flex-wrap: wrap; gap: 0 var(--space-6); align-content: start; }
  .links a { min-height: 44px; display: inline-flex; align-items: center; }
  a { color: var(--on-dark); overflow-wrap: anywhere; }
  a:hover { color: var(--on-dark-soft); }
</style>
