---
// The main feature: price (apricot) and key facts on a dark card. facts: [{ label, value }].
const { label, price, facts = [], note, ctaHref, ctaLabel } = Astro.props;
---
<div class="price-card">
  <p class="price-card__label">{label}</p>
  <p class="price-card__price">{price}</p>
  <dl class="price-card__facts">
    {facts.map((f) => (<div><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
  </dl>
  {note && <p class="price-card__note">{note}</p>}
  {ctaHref && <a class="btn btn-primary btn-lg price-card__cta" href={ctaHref}>{ctaLabel}</a>}
</div>

<style>
  .price-card { --focus: var(--accent); background: var(--brand-dark); color: var(--on-dark); border-radius: var(--radius-l); padding: var(--space-8); }
  .price-card__label { margin: 0; color: var(--on-dark-muted); font-weight: 600; }
  /* Large numerals carry side bearing: pull left so "€" lines up with the label by eye */
  .price-card__price { font-size: clamp(72px, 8vw, 96px); font-weight: var(--fw-black); margin: var(--space-1) 0 var(--space-5) -0.05em; letter-spacing: -0.04em; line-height: 1; color: var(--accent); }
  .price-card__facts { margin: 0; }
  .price-card__facts div { display: flex; justify-content: space-between; gap: var(--space-3); padding: var(--space-3) 0; border-top: 1px solid rgba(255,255,255,.12); font-size: var(--fs-body); }
  .price-card__facts dt { color: var(--on-dark-muted); }
  .price-card__facts dd { margin: 0; font-weight: 700; }
  .price-card__note { margin: 0; padding-top: var(--space-3); border-top: 1px solid rgba(255,255,255,.12); font-size: 15px; color: var(--on-dark-soft); }
  .price-card__cta { width: 100%; margin-top: var(--space-5); }
  @media (max-width: 820px) { .price-card { padding: var(--space-6); } }
</style>
