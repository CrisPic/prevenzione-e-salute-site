---
// One service: icon, title, price or tag, description. featured = teal card (the certificate), larger.
import IconTile from './IconTile.astro';
const { icon, title, price, description, featured = false, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}`;
---
<article class:list={['service', { 'service--featured': featured }]}>
  <H class="service__title">{title}</H>
  <div class="service__top">
    <IconTile icon={icon} />
    {price && <p class:list={['service__price', { 'service__price--tag': !featured }]}>{price}</p>}
  </div>
  {description && <p class="service__desc">{description}</p>}
  <slot />
</article>

<style>
  /* Card holds a radius-s icon tile at its padding edge: radius = radius-s + padding */
  .service { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-card); padding: var(--pad-card); display: flex; flex-direction: column; gap: var(--space-3); }
  .service__top { order: -1; display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); margin-bottom: var(--space-1); }
  .service__price { margin: 0; font-size: 28px; font-weight: var(--fw-black); letter-spacing: -.02em; line-height: 1; color: var(--brand-dark); }
  .service__price--tag { font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0; background: var(--brand-soft); padding: 6px var(--space-3); border-radius: var(--radius-pill); }
  .service__title { margin: 0; font-size: var(--fs-h3); line-height: 1.2; color: var(--brand-dark); }
  .service__desc { margin: 0; color: var(--muted); }

  /* Main feature: bigger type and room, pushed to the bottom of a tall card */
  .service--featured { --focus: var(--accent); --pad-card: 28px; background: var(--brand); border-color: var(--brand); color: var(--on-dark); }
  .service--featured .service__price { color: var(--accent); font-size: 44px; letter-spacing: -.03em; }
  .service--featured .service__title { color: var(--on-dark); font-size: clamp(22px, 2.4vw, 28px); }
  .service--featured .service__desc { color: var(--on-dark-soft); font-size: var(--fs-md); }
  .service--featured .service__top { margin-bottom: auto; padding-bottom: var(--space-8); }
  @media (max-width: 820px) { .service--featured { --pad-card: 24px; } .service--featured .service__top { padding-bottom: var(--space-4); } }
</style>
