---
// One FAQ entry. Native <details>: keyboard and screen-reader friendly, no JavaScript.
const { q, a, open = false } = Astro.props;
---
<details class="faq" open={open}>
  <summary class="faq__q">
    <span>{q}</span>
    <span class="faq__icon" aria-hidden="true"></span>
  </summary>
  <div class="faq__a">{a && <p>{a}</p>}<slot /></div>
</details>

<style>
  .faq { border-bottom: 1px solid var(--line); }
  .faq__q { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); min-height: 56px; padding: var(--space-3) 0; cursor: pointer; font-weight: var(--fw-semibold); color: var(--brand-dark); }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--brand); }
  /* Plus / minus drawn with two bars */
  .faq__icon { flex: 0 0 16px; height: 16px; position: relative; }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: var(--brand); }
  .faq__icon::after { transform: rotate(90deg); transition: transform var(--dur) var(--ease); }
  .faq[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__a { padding: 0 0 var(--space-4); color: var(--text); max-width: 60ch; }
  .faq__a :global(p) { margin: 0; }
</style>
