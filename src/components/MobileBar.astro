---
import { site, booking } from '../data/site.js';
const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
// WhatsApp / Chiama appear only once the real number is in site.js
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}` : '';
const tel = site.phone ? `tel:${site.phone}` : '';
// On the booking page the form is the action: no second "Prenota" competing with it.
const onBooking = Astro.url.pathname.startsWith('/prenota');
const items = [!onBooking && 'book', wa && 'wa', tel && 'tel'].filter(Boolean);
// A lone Prenota carries a one-line recap of the certificate, so the bar says what is being booked
const cert = booking.services.find((s) => s.id === 'certificato');
const recap = items.length === 1 && items[0] === 'book' && cert;
---
{items.length > 0 ? (
  <nav class:list={['mbar', { 'mbar--recap': recap }]} aria-label="Azioni rapide" data-mbar>
    {recap && <p class="mbar__recap"><strong>{cert.price} · circa {cert.minutes} min</strong><span>Certificati sportivi</span></p>}
    {!onBooking && <a href={recap ? `${bookHref}?servizio=${cert.id}` : bookHref} class="btn btn-primary">Prenota</a>}
    {wa && <a href={wa} class="btn">WhatsApp</a>}
    {tel && <a href={tel} class="btn">Chiama</a>}
  </nav>
) : (
  <style is:inline>@media (max-width: 820px) { :root { --mbar-space: 0px; } }</style>
)}

<script>
  // While the page's own main button ([data-primary-cta]) is on screen, the bar stays out of the way:
  // one primary action per view. Without JS (or without that button) the bar is always shown.
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const cta = document.querySelector('[data-primary-cta]');
  if (bar && cta && 'IntersectionObserver' in window) {
    // Step aside only once most of the button is visible; never hide the bar while it holds keyboard focus
    new IntersectionObserver(([e]) => {
      if (bar.contains(document.activeElement)) return;
      bar.classList.toggle('is-away', e.intersectionRatio >= 0.6);
    }, { threshold: [0, 0.6, 1] }).observe(cta);
  }
</script>

<style>
  .mbar { display: none; }
  @media (max-width: 820px) {
    .mbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; gap: var(--space-2); align-items: center; padding: var(--space-3) var(--gutter) calc(var(--space-3) + env(safe-area-inset-bottom)); background: var(--bg); border-top: 2px solid var(--rule); }
    .mbar .btn { flex: 1 1 0; min-height: 48px; padding: 0 var(--space-3); }
    .mbar--recap .btn { flex: 0 0 auto; padding: 0 var(--space-6); }
    .mbar__recap { flex: 1 1 auto; margin: 0; display: grid; font-size: var(--fs-xs); line-height: 1.35; color: var(--muted); }
    .mbar__recap strong { font-size: var(--fs-sm); color: var(--brand-dark); font-variant-numeric: tabular-nums; }
    .mbar.is-away { visibility: hidden; }
  }
</style>
