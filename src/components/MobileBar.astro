---
import { site } from '../data/site.js';
const bookHref = '/prenota/'; // always via Prenota, so the privacy gate is shown first
// WhatsApp / Chiama appear only once the real number is in site.js
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}` : '';
const tel = site.phone ? `tel:${site.phone}` : '';
// On the booking page the form is the action: no second "Prenota" competing with it.
// Only a lone Prenota floats without the dark tray; WhatsApp/Chiama always keep the tray (white text).
const onBooking = Astro.url.pathname.startsWith('/prenota');
const items = [!onBooking && 'book', wa && 'wa', tel && 'tel'].filter(Boolean);
const cols = items.length === 3 ? '1.4fr 1fr 1fr' : items.length === 2 && !onBooking ? '1.4fr 1fr' : `repeat(${items.length}, 1fr)`;
---
{items.length > 0 ? (
  <nav class:list={['mbar', { 'mbar--solo': items.length === 1 && items[0] === 'book' }]} aria-label="Azioni rapide" style={`--mbar-cols:${cols}`}>
    {!onBooking && <a href={bookHref} class="main">Prenota</a>}
    {wa && <a href={wa}>WhatsApp</a>}
    {tel && <a href={tel}>Chiama</a>}
  </nav>
) : (
  <style is:inline>@media (max-width: 820px) { :root { --mbar-space: 0px; } }</style>
)}

<style>
  .mbar { display: none; }
  @media (max-width: 820px) {
    /* Several actions: slim dark tray (4px), pills inside a pill keep concentric corners */
    .mbar { --focus: var(--accent); position: fixed; left: var(--space-4); right: var(--space-4); bottom: var(--space-4); z-index: 30; display: grid; grid-template-columns: var(--mbar-cols, 1.4fr 1fr 1fr); gap: var(--space-1); padding: var(--space-1); background: var(--brand-dark); border-radius: var(--radius-pill); box-shadow: var(--shadow-float); }
    /* One action: no tray, just the button floating on a soft shadow */
    .mbar--solo { --focus: var(--brand-dark); padding: 0; background: none; box-shadow: none; }
    .mbar--solo a.main { min-height: 52px; font-size: var(--fs-body); box-shadow: var(--shadow-button); }
    .mbar a { display: flex; align-items: center; justify-content: center; min-height: 48px; text-align: center; padding: 0 6px; border-radius: var(--radius-pill); color: var(--on-dark); text-decoration: none; font-weight: var(--fw-semibold); font-size: 15px; transition: transform var(--dur-fast) var(--ease); }
    .mbar a:active { transform: scale(.97); }
    .mbar a.main { background: var(--accent); color: var(--brand-dark); font-weight: var(--fw-bold); }
  }
</style>
