---
// The only way icons are drawn: same stroke, caps and colour everywhere. Decorative (aria-hidden).
import { icons } from './icons.js';
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[name]} />
