{
  // Cloudflare Workers config: serves the static site built by Astro + the booking API
  "name": "prevenzione-e-salute-site",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API calls run the Worker; every page is served straight from the static assets
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // "off" (production: bookings go through the Medaid calendar) | "mock" (demo form, nothing saved)
    "BOOKING_MODE": "off"
  },
  // Branch builds (`wrangler preview`) use these instead of "vars": demo booking only,
  // so a preview never creates real appointments.
  "previews": {
    "vars": { "BOOKING_MODE": "mock" }
  },
  "observability": { "enabled": true }
}
