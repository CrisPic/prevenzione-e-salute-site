{
  // Cloudflare Workers config: serves the static site built by Astro + the booking API
  "name": "prevenzione-e-salute-site",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API calls run the Worker; every page is served straight from the static assets
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // "off" | "mock" (demo, nothing saved) | "calcom" (needs secret CALCOM_API_KEY: npx wrangler secret put CALCOM_API_KEY)
    "BOOKING_MODE": "calcom"
  },
  "observability": { "enabled": true }
}
