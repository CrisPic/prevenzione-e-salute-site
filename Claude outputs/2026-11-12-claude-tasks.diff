diff --git a/src/components/PriceCard.astro b/src/components/PriceCard.astro
new file mode 100644
index 0000000..23791aa
--- /dev/null
+++ b/src/components/PriceCard.astro
@@ -0,0 +1,25 @@
+---
+// Dark summary card with the price (lime) and key facts. facts: [{ label, value }].
+const { label, price, facts = [], ctaHref, ctaLabel } = Astro.props;
+---
+<div class="price-card">
+  <svg class="price-card__pulse" viewBox="0 0 300 60" aria-hidden="true"><path d="M0 34h80l14-22 18 44 16-30 10 8h162" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg>
+  <p class="price-card__label">{label}</p>
+  <p class="price-card__price">{price}</p>
+  <dl class="price-card__facts">
+    {facts.map((f) => (<div><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
+  </dl>
+  {ctaHref && <a class="btn btn-primary price-card__cta" href={ctaHref}>{ctaLabel}</a>}
+</div>
+
+<style>
+  .price-card { --focus: var(--accent); background: var(--brand-dark); color: #fff; border-radius: var(--radius-l); padding: 28px; box-shadow: 0 20px 50px rgba(10,63,68,.25); }
+  .price-card__pulse { width: 100%; height: 48px; margin-bottom: 8px; color: #a9cfcf; }
+  .price-card__label { margin: 0; color: #a9cfcf; font-weight: 600; }
+  .price-card__price { font-size: 64px; font-weight: 800; margin: 0 0 12px; letter-spacing: -0.03em; line-height: 1.1; color: var(--accent); }
+  .price-card__facts { margin: 0; }
+  .price-card__facts div { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-top: 1px solid rgba(255,255,255,.12); font-size: 15px; }
+  .price-card__facts dt { color: #a9cfcf; }
+  .price-card__facts dd { margin: 0; font-weight: 700; }
+  .price-card__cta { width: 100%; margin-top: 16px; }
+</style>
diff --git a/src/components/ServiceRow.astro b/src/components/ServiceRow.astro
new file mode 100644
index 0000000..47c65b0
--- /dev/null
+++ b/src/components/ServiceRow.astro
@@ -0,0 +1,28 @@
+---
+// One service: icon, title, price or tag, description. featured = teal card (the certificate).
+import IconTile from './IconTile.astro';
+const { icon, title, price, description, featured = false, headingLevel = 3 } = Astro.props;
+const H = `h${headingLevel}`;
+---
+<article class:list={['service', { 'service--featured': featured }]}>
+  <div class="service__top">
+    <IconTile icon={icon} />
+    <p class:list={['service__price', { 'service__price--tag': !featured }]}>{price}</p>
+  </div>
+  <H class="service__title">{title}</H>
+  {description && <p class="service__desc">{description}</p>}
+  <slot />
+</article>
+
+<style>
+  .service { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-m); padding: 24px; display: flex; flex-direction: column; gap: 12px; }
+  .service__top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
+  .service__price { margin: 0; font-size: 28px; font-weight: 800; letter-spacing: -.02em; color: var(--brand-dark); }
+  .service__price--tag { font-size: 14px; font-weight: 700; letter-spacing: 0; background: var(--brand-soft); padding: 6px 12px; border-radius: 999px; }
+  .service__title { margin: 0; font-size: 21px; line-height: 1.2; color: var(--brand-dark); }
+  .service__desc { margin: 0; color: var(--muted); }
+  .service--featured { --focus: var(--accent); background: var(--brand); border-color: var(--brand); color: #fff; }
+  .service--featured .service__price { color: var(--accent); }
+  .service--featured .service__title { color: #fff; }
+  .service--featured .service__desc { color: #cfe3e3; }
+</style>
diff --git a/src/components/StepTimeline.astro b/src/components/StepTimeline.astro
new file mode 100644
index 0000000..f3b2d2d
--- /dev/null
+++ b/src/components/StepTimeline.astro
@@ -0,0 +1,29 @@
+---
+// Numbered vertical timeline. steps: [{ title?, text }] or plain strings.
+const { steps = [] } = Astro.props;
+const items = steps.map((s) => (typeof s === 'string' ? { text: s } : s));
+---
+<ol class="timeline">
+  {items.map((s, i) => (
+    <li class:list={['timeline__item', { 'timeline__item--last': i === items.length - 1 }]}>
+      <span class="timeline__num" aria-hidden="true">{i + 1}</span>
+      <div class="timeline__body">
+        {s.title && <p class="timeline__title">{s.title}</p>}
+        <p class="timeline__text">{s.text}</p>
+      </div>
+    </li>
+  ))}
+</ol>
+
+<style>
+  .timeline { list-style: none; padding: 0; margin: 0; }
+  .timeline__item { position: relative; display: flex; gap: 16px; padding-bottom: 20px; }
+  .timeline__item:not(.timeline__item--last)::before { content: ''; position: absolute; left: 19px; top: 40px; bottom: 0; width: 2px; background: #9fc6c6; }
+  .timeline__item--last { padding-bottom: 0; }
+  .timeline__num { flex: 0 0 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-weight: 750; background: var(--brand); color: #fff; position: relative; }
+  .timeline__item--last .timeline__num { background: var(--brand-soft); color: var(--brand-dark); box-shadow: inset 0 0 0 2px var(--brand); }
+  .timeline__body { padding-top: 8px; }
+  .timeline__title { margin: 0; font-weight: 700; color: var(--brand-dark); }
+  .timeline__text { margin: 0; color: var(--text); }
+  .timeline__title + .timeline__text { color: var(--muted); font-size: 15px; }
+</style>
